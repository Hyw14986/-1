/**
 * app.wxss - 全局样式
 * 主色调：清新浅蓝 #29B6F6 / #4FC3F7，便民简约风格
 * 全部使用 rpx 移动端适配
 */

page {
  background-color: #F5F7FA;
  color: #333333;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

/* 通用卡片 */
.card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(41, 182, 246, 0.08);
}

/* 主按钮 */
.btn-primary {
  background: linear-gradient(135deg, #4FC3F7, #29B6F6);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  padding: 20rpx 0;
  text-align: center;
  line-height: 1.4;
}

.btn-primary::after {
  border: none;
}

.btn-primary.btn-disabled {
  opacity: 0.5;
}

/* 次要按钮（描边） */
.btn-outline {
  background: #FFFFFF;
  color: #29B6F6;
  border: 2rpx solid #29B6F6;
  font-size: 28rpx;
  border-radius: 40rpx;
  padding: 16rpx 0;
  text-align: center;
  line-height: 1.4;
}

.btn-outline::after {
  border: none;
}

/* 设施标签 */
.tag {
  display: inline-block;
  font-size: 22rpx;
  color: #29B6F6;
  background: rgba(41, 182, 246, 0.1);
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.tag-tip {
  display: inline-block;
  font-size: 22rpx;
  color: #FFFFFF;
  background: #29B6F6;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
  margin-right: 12rpx;
}

/* 星级文字 */
.star-text {
  color: #FFB400;
  font-size: 26rpx;
  letter-spacing: 2rpx;
}

.star-text.empty {
  color: #E0E6EC;
}

/* 空状态 */
.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #9AA5B1;
  font-size: 28rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  color: #B9C4CE;
}

/* 列表卡片通用 */
.list-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(41, 182, 246, 0.08);
}

.list-card:active {
  transform: scale(0.98);
}
