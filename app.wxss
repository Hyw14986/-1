/**
 * app.wxss - 全局样式（可爱马卡龙风）
 * 主色调：浅天蓝 #74b9ff（按钮、选中tab、强调元素）
 * 辅助色：浅粉 #ffb8d1、薄荷绿 #a8e6cf
 * 页面背景：#f7faff；正文 #2c3e50；次要文字 #7f8c8d
 * 卡片圆角 20-24rpx、按钮药丸圆角 50rpx、输入框圆角 16rpx、柔和浅蓝阴影
 * 全部使用 rpx 移动端适配
 */

page {
  background-color: #fff9ef;
  color: #2c3e50;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

/* ---------- 通用卡片 ---------- */
.card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 169, 77, 0.16);
}

/* ---------- 可爱卡片：白色、大圆角、柔和浅蓝阴影、四周留白 ---------- */
.cute-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 169, 77, 0.14);
  margin: 24rpx 24rpx 0;
}

/* ---------- 药丸主按钮 ---------- */
.btn-primary {
  background: linear-gradient(135deg, #74b9ff, #a8e6cf);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 50rpx;
  padding: 20rpx 0;
  text-align: center;
  line-height: 1.4;
  box-shadow: 0 8rpx 20rpx rgba(116, 185, 255, 0.35);
}

.btn-primary::after {
  border: none;
}

.btn-primary.btn-disabled {
  opacity: 0.5;
  box-shadow: none;
}

/* ---------- 可爱药丸按钮 ---------- */
.cute-btn {
  background: linear-gradient(135deg, #74b9ff, #a8e6cf);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 50rpx;
  padding: 20rpx 48rpx;
  text-align: center;
  line-height: 1.4;
  box-shadow: 0 8rpx 20rpx rgba(116, 185, 255, 0.35);
}

.cute-btn::after {
  border: none;
}

/* ---------- 药丸描边按钮 ---------- */
.btn-outline {
  background: #ffffff;
  color: #74b9ff;
  border: 2rpx solid #74b9ff;
  font-size: 28rpx;
  border-radius: 50rpx;
  padding: 16rpx 0;
  text-align: center;
  line-height: 1.4;
}

.btn-outline::after {
  border: none;
}

/* ---------- 输入框统一可爱风格 ---------- */
input,
textarea {
  background: #f0f7ff;
  border-radius: 16rpx;
}

/* 占位符文字（配合 placeholder-class="ph" 使用，降低透明度） */
.ph {
  color: #a9c4e8;
  opacity: 0.75;
}

/* ---------- 设施标签 ---------- */
.tag {
  display: inline-block;
  font-size: 22rpx;
  color: #74b9ff;
  background: rgba(116, 185, 255, 0.14);
  border-radius: 24rpx;
  padding: 8rpx 18rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.tag-tip {
  display: inline-block;
  font-size: 22rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #74b9ff, #a8e6cf);
  border-radius: 24rpx;
  padding: 8rpx 18rpx;
  margin-right: 12rpx;
}

/* ---------- 星级文字 ---------- */
.star-text {
  color: #ffb400;
  font-size: 26rpx;
  letter-spacing: 2rpx;
}

.star-text.empty {
  color: #e6ebf2;
}

/* ---------- 空状态 ---------- */
.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #7f8c8d;
  font-size: 28rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

/* ---------- 列表卡片通用 ---------- */
.list-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 169, 77, 0.14);
}

.list-card:active {
  transform: scale(0.98);
}