/* 底部自定义 TabBar：两个 tab 在浮岛上水平、垂直居中；不使用 gap，保证兼容性 */
.tab-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 999;
  box-sizing: border-box;
  height: 112rpx;
  padding: 0 26rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid #dceeff;
  border-radius: 56rpx;
  box-shadow: 0 12rpx 34rpx rgba(64, 150, 255, 0.12);
  backdrop-filter: blur(24rpx);
}

.tab-item {
  box-sizing: border-box;
  width: 220rpx;
  height: 84rpx;
  margin: 0 16rpx;
  border-radius: 42rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: background 0.2s ease, transform 0.2s ease;
}

.tab-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 6rpx;
  flex-shrink: 0;
}

.tab-text {
  font-size: 20rpx;
  line-height: 1.1;
  color: #8aa5c4;
  font-weight: 500;
}

.tab-item.active {
  background: #e8f4ff;
}

.tab-item.active .tab-text {
  color: #4096ff;
  font-weight: 600;
}

.item-hover {
  opacity: 0.82;
  transform: scale(0.96);
}

.tab-center {
  width: 88rpx;
  height: 88rpx;
  margin: 0 8rpx;
  border-radius: 50%;
  background: #4096ff;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 6rpx solid #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(64, 150, 255, 0.22);
  flex-shrink: 0;
}

.center-plus {
  width: 44rpx;
  height: 44rpx;
}

.center-hover {
  opacity: 0.85;
  transform: scale(0.94);
}


