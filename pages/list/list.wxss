/* pages/list/list.wxss - 厕所列表页样式（温馨可爱扁平插画风，与首页同款） */
.page {
  padding: 24rpx 24rpx 200rpx;
  background: #fff9ef;
}

/* ---------- 顶部标题区（与首页品牌区同款） ---------- */
.header {
  display: flex;
  align-items: center;
  padding: 8rpx 8rpx 20rpx;
}

.logo {
  width: 88rpx;
  height: 88rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.welcome-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #2c3e50;
  letter-spacing: 2rpx;
}

.welcome-sub {
  font-size: 24rpx;
  color: #7f8c8d;
  margin-top: 6rpx;
}

/* 统计提示：暖橙小胶囊 */
.toast-tip {
  display: inline-block;
  font-size: 24rpx;
  color: #e8833a;
  background: rgba(255, 169, 77, 0.14);
  border-radius: 24rpx;
  padding: 10rpx 22rpx;
  margin: 0 8rpx 24rpx;
}

/* 卡片主体：左侧图标 + 右侧信息 */
.card-main {
  display: flex;
  align-items: flex-start;
}

.toilet-ico {
  width: 64rpx;
  height: 64rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.card-body {
  flex: 1;
  min-width: 0;
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.toilet-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c3e50;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.distance {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #e8833a;
  background: rgba(255, 169, 77, 0.16);
  border-radius: 24rpx;
  padding: 6rpx 16rpx;
  margin-left: 20rpx;
}

.card-rating {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.rating-num {
  font-size: 24rpx;
  color: #ffb400;
  margin-left: 8rpx;
}

.rating-count {
  font-size: 22rpx;
  color: #7f8c8d;
  margin-left: 12rpx;
}

.card-tags {
  margin-top: 16rpx;
}

.card-address {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #7f8c8d;
}

.addr-icon {
  margin-right: 8rpx;
}

.empty-btn {
  width: 320rpx;
  margin: 40rpx auto 0;
}

/* 悬浮加号按钮（暖橙渐变，呼应首页一键导航） */
.fab-add {
  position: fixed;
  right: 32rpx;
  bottom: 64rpx;
  z-index: 100;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ffb85c, #ffa94d);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 26rpx rgba(255, 169, 77, 0.5);
}

.fab-plus {
  font-size: 60rpx;
  line-height: 1;
  margin-top: -4rpx;
}

.fab-hover {
  opacity: 0.85;
  transform: scale(0.95);
}

/* 卡片操作按钮 */
.card-actions {
  display: flex;
  margin-top: 20rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #ffa94d;
  background: #ffffff;
  border: 2rpx solid #ffa94d;
  border-radius: 40rpx;
  padding: 12rpx 0;
  margin-right: 20rpx;
}

.action-btn:last-child {
  margin-right: 0;
}

.action-primary {
  background: linear-gradient(135deg, #ffb85c, #ffa94d);
  color: #ffffff;
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(255, 169, 77, 0.4);
}