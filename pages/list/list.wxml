<!-- pages/list/list.wxml - 厕所列表页（苹果白简约风格，SVG 图标） -->
<view class="page">
  <!-- 顶部 Hero -->
  <view class="hero">
    <image class="logo" src="/images/logo-toilet.png" mode="aspectFit" />
    <view class="welcome">
      <view class="welcome-title">附近公厕</view>
      <view class="welcome-sub">按距离由近到远，帮你找最近的好去处</view>
    </view>
    <view class="bubble l1"></view>
    <view class="bubble l2"></view>
  </view>

  <view class="toast-tip" wx:if="{{toilets.length}}">共找到 {{toilets.length}} 个公共厕所</view>

  <view class="list" wx:if="{{!loading}}">
    <view
      class="list-card"
      wx:for="{{toilets}}"
      wx:key="_id"
      data-id="{{item._id}}"
      bindtap="goDetail"
    >
      <view class="card-main">
        <image class="toilet-ico" src="/images/icons/toilet.svg" mode="aspectFit" />
        <view class="card-body">
      <view class="card-top">
        <view class="toilet-name">{{item.name}}</view>
        <view class="distance">{{item.distanceText}}</view>
      </view>
      <view class="card-rating">
        <star-rating value="{{item.rating}}" size="26" disabled="{{true}}" />
        <text class="rating-num">{{item.rating ? item.rating : '暂无评分'}}</text>
        <text class="rating-count" wx:if="{{item.ratingCount}}">({{item.ratingCount}}人评价)</text>
      </view>
      <view class="card-tags" wx:if="{{item.tags.length}}">
        <text class="tag" wx:for="{{item.tags}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="card-address" wx:if="{{item.address}}">
        <image class="addr-icon" src="/images/icons/pin.svg" />
        <text>{{item.address}}</text>
      </view>
      <view class="card-actions">
        <view class="action-btn" catchtap="goDetail" data-id="{{item._id}}">查看详情</view>
        <view class="action-btn action-primary" catchtap="navToToilet" data-id="{{item._id}}">
          <image class="btn-ico" src="/images/icons/nav-white.svg" />
          <text>导航</text>
        </view>
      </view>
        </view>
      </view>
    </view>

    <van-empty wx:if="{{!toilets.length && !loadError}}" image="" custom-class="list-empty">
      <view slot="image">
        <image class="empty-icon" src="/images/icons/toilet.svg" />
      </view>
      <view slot="description" class="empty-desc">附近暂时没有公厕，点击下方按钮上报一个吧</view>
      <view class="empty-btn btn-primary" bindtap="goMap">返回首页</view>
    </van-empty>

    <van-empty wx:if="{{loadError}}" image="" custom-class="list-empty">
      <view slot="image">
        <image class="empty-icon" src="/images/icons/warn.svg" />
      </view>
      <view slot="description" class="empty-desc">{{loadError}}</view>
      <view class="empty-btn btn-primary" bindtap="reload">重新加载</view>
    </van-empty>
  </view>

  <view class="skeleton-list" wx:if="{{loading}}">
    <view class="skeleton-card" wx:for="{{[1,2,3]}}" wx:key="*this">
      <van-skeleton avatar title row="2" animate custom-class="skeleton-inner"></van-skeleton>
    </view>
    <view class="loading-row">
      <van-loading type="spinner" size="32rpx" color="#007AFF"></van-loading>
      <text class="loading-text">加载中…</text>
    </view>
  </view>

  <!-- 悬浮加号：随时上报新公厕 -->
  <view class="fab-add" hover-class="fab-hover" bindtap="goReport">
    <image class="fab-plus" src="/images/icons/plus-white.svg" />
  </view>
</view>