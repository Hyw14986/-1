/* pages/searchRecord/searchRecord.wxss - 查询记录页「苹果白」简约版（业务绑定零改动，无渐变） */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 80rpx;
  background: #f5f5f7;
}

.head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.head-title {
  display: flex;
  align-items: center;
  font-size: 40rpx;
  font-weight: 800;
  color: #1d1d1f;
}

.head-ico {
  width: 40rpx;
  height: 40rpx;
  margin-right: 14rpx;
}

.clear-btn {
  display: flex;
  align-items: center;
  padding: 10rpx 24rpx;
  border-radius: 40rpx;
  background: #ffffff;
  border: 1rpx solid #efeff4;
  color: #6e6e73;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.04);
}

.btn-sm-ico {
  width: 26rpx;
  height: 26rpx;
  margin-right: 8rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
}

.empty-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #6e6e73;
}

.empty-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #aeaeb2;
}

/* 记录卡片 */
.record-card {
  margin-bottom: 22rpx;
}

.record-head {
  display: flex;
  align-items: center;
}

.record-head.zero {
  opacity: 0.55;
}

.record-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
}

.record-head-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.record-main {
  margin-top: 18rpx;
  background: #f2f2f7;
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
}

.record-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.record-label {
  font-size: 24rpx;
  color: #6e6e73;
}

.record-value {
  font-size: 24rpx;
  color: #1d1d1f;
  font-weight: 600;
}

.record-actions {
  display: flex;
  margin-top: 20rpx;
}

.again-btn,
.del-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  padding: 16rpx 0;
  border-radius: 44rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.again-btn {
  background: #007aff;
  color: #ffffff;
  margin-right: 18rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 122, 255, 0.24);
}

.del-btn {
  background: #f2f2f7;
  color: #3a3a3c;
}
/* Vant empty 组件适配 */
.record-empty {
  padding: 80rpx 0 20rpx;
}
.record-empty-desc {
  display: flex;
  flex-direction: column;
  align-items: center;
}



/* 视觉升级覆盖：查询记录玻璃卡片 */
.page {
  background: transparent;
}

.head-title {
  color: #1d1d1f;
}

.clear-btn {
  background: rgba(255, 255, 255, 0.82);
  border-color: rgba(255, 255, 255, 0.92);
  box-shadow: 0 12rpx 34rpx rgba(47, 87, 150, 0.1);
}

.record-card {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 14rpx 40rpx rgba(47, 87, 150, 0.1);
  backdrop-filter: blur(16rpx);
}

.record-main {
  background: rgba(244, 248, 255, 0.9);
}

.again-btn {
  background: linear-gradient(135deg, #4facfe, #3478f6);
  color: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(52, 120, 246, 0.28);
}

.del-btn {
  background: rgba(255, 255, 255, 0.9);
}



/* ============================================================
   查询记录页结构重排：记录概览 + 玻璃卡片
   ============================================================ */
.record-summary {
  display: flex;
  align-items: baseline;
  margin: -6rpx 0 22rpx;
  padding: 22rpx 26rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.92) 0%, rgba(240, 248, 255, 0.94) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  box-shadow: 0 12rpx 34rpx rgba(47, 87, 150, 0.08);
}

.summary-count {
  font-size: 52rpx;
  font-weight: 800;
  color: #3478f6;
  margin-right: 12rpx;
}

.summary-text {
  font-size: 24rpx;
  color: #6e6e73;
}