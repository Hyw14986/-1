/* pages/profile/profile.wxss - 我的页面样式（可爱马卡龙风） */
.page {
  padding: 24rpx 24rpx 60rpx;
}

/* 用户头部：渐变背景 + 大圆角卡片 */
.user-card {
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #74b9ff, #a8e6cf);
  box-shadow: 0 12rpx 32rpx rgba(116, 185, 255, 0.4);
}

.avatar-btn {
  background: transparent;
  padding: 0;
  margin: 0;
  width: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: none;
  line-height: 1.2;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #ffffff;
  border: 6rpx solid #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(44, 62, 80, 0.15);
}

.avatar-tip {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 10rpx;
}

.user-info {
  flex: 1;
  margin-left: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.nickname-input {
  width: 100%;
  height: 72rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.28);
  border-radius: 16rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.save-btn {
  width: 200rpx;
  padding: 12rpx 0;
  font-size: 26rpx;
  margin-top: 16rpx;
  background: #ffffff;
  color: #74b9ff;
  box-shadow: 0 6rpx 16rpx rgba(44, 62, 80, 0.12);
}

/* 区块卡片 */
.section-card {
  margin-top: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 8rpx;
}

/* 上报/评价条目 */
.report-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #eef4fc;
}

.report-item:last-child {
  border-bottom: none;
}

.report-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.report-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2c3e50;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 20rpx;
}

.report-status {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #74b9ff;
  background: rgba(116, 185, 255, 0.14);
  border-radius: 24rpx;
  padding: 4rpx 14rpx;
}

.report-meta {
  font-size: 22rpx;
  color: #7f8c8d;
  margin-top: 8rpx;
}

.report-content {
  font-size: 26rpx;
  color: #5b6b79;
  margin-top: 10rpx;
}

/* 开发工具 */
.dev-tip {
  font-size: 24rpx;
  color: #7f8c8d;
  margin-bottom: 20rpx;
}

.dev-btn {
  width: 100%;
  padding: 14rpx 0;
  font-size: 28rpx;
  border-radius: 50rpx;
}