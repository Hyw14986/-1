/* pages/profile/profile.wxss - 我的页面（治愈马卡龙风） */
.page {
  min-height: 100vh;
  padding: 0 0 60rpx;
  background: #f7faff;
  box-sizing: border-box;
}

/* 返回主页按钮：白色药丸 + 柔和蓝调阴影 */
.back-home {
  display: inline-flex;
  align-items: center;
  margin: 28rpx 28rpx 0;
  padding: 12rpx 32rpx;
  background: #ffffff;
  border-radius: 44rpx;
  color: #74b9ff;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(116, 185, 255, 0.18);
}

.back-home-icon {
  margin-right: 8rpx;
  font-size: 28rpx;
}

.back-home.hover {
  opacity: 0.8;
}

/* 用户头部：柔蓝到薄荷绿渐变 + 大圆角 + 柔和阴影 */
.user-card {
  display: flex;
  align-items: center;
  margin: 28rpx 28rpx 0;
  padding: 52rpx 40rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #74b9ff, #a8e6cf);
  box-shadow: 0 16rpx 40rpx rgba(116, 185, 255, 0.3);
}

.avatar-btn {
  background: transparent;
  padding: 0;
  margin: 0;
  width: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: none;
  line-height: 1.2;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 124rpx;
  height: 124rpx;
  border-radius: 50%;
  background: #ffffff;
  border: 6rpx solid #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(63, 78, 102, 0.16);
}

.avatar-tip {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.92);
  margin-top: 12rpx;
}

.user-info {
  flex: 1;
  margin-left: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.nickname-input {
  width: 100%;
  height: 80rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.32);
  border-radius: 24rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  margin-bottom: 22rpx;
}

/* 保存资料：药丸圆角 */
.save-btn {
  width: 260rpx;
  padding: 14rpx 0;
  font-size: 26rpx;
  border-radius: 50rpx;
  background: #ffffff;
  color: #74b9ff;
  text-align: center;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(116, 185, 255, 0.28);
}

.save-btn.hover {
  opacity: 0.85;
}

/* 今日剩余查询次数卡片 */
.quota-card {
  margin: 28rpx 28rpx 0;
  padding: 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #a8e6cf, #74b9ff);
  box-shadow: 0 14rpx 36rpx rgba(116, 185, 255, 0.3);
  color: #ffffff;
}

.quota-title {
  font-size: 26rpx;
  font-weight: 600;
}

.quota-num {
  margin-top: 12rpx;
  font-size: 30rpx;
  opacity: 0.95;
}

.quota-count {
  font-size: 64rpx;
  font-weight: 800;
  margin-right: 6rpx;
}

.quota-bar {
  height: 20rpx;
  margin-top: 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.35);
  overflow: hidden;
}

.quota-fill {
  height: 100%;
  border-radius: 20rpx;
  background: linear-gradient(90deg, #ffb8d1, #ff9fb2);
  transition: width 0.3s;
}

.quota-tip {
  margin-top: 14rpx;
  font-size: 22rpx;
  opacity: 0.9;
}

/* 功能入口菜单 */
.menu-card {
  padding: 12rpx 32rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 2rpx solid #eef4fc;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item.hover {
  opacity: 0.75;
}

.menu-left {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #2c3e50;
}

.menu-icon {
  margin-right: 18rpx;
  font-size: 34rpx;
}

.menu-arrow {
  font-size: 40rpx;
  color: #b8bfcc;
}

/* 区块卡片 */
.section-card {
  margin-top: 28rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c3e50;
  padding-top: 8rpx;
  margin-bottom: 8rpx;
}

/* 空状态：放大图标、增加上下间距 */
.section-card .empty {
  padding: 140rpx 0;
}

.section-card .empty-icon {
  font-size: 140rpx;
  margin-bottom: 28rpx;
}

/* 上报/评价/收藏条目 */
.report-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #eef4fc;
}

.report-item.hover {
  opacity: 0.75;
}

.report-item:last-child {
  border-bottom: none;
}

.report-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.report-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2c3e50;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 20rpx;
}

.report-status {
  flex-shrink: 0;
  font-size: 22rpx;
  border-radius: 26rpx;
  padding: 4rpx 14rpx;
}

.status-pending {
  color: #e6a23c;
  background: rgba(255, 193, 7, 0.16);
}

.status-pass {
  color: #2e9e6b;
  background: rgba(168, 230, 207, 0.45);
}

.status-reject {
  color: #e05a6d;
  background: rgba(255, 159, 178, 0.3);
}

.report-fav-score {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #ffc94d;
}

.report-meta {
  font-size: 22rpx;
  color: #7f8c8d;
  margin-top: 8rpx;
}

.report-content {
  font-size: 26rpx;
  color: #6b7a93;
  margin-top: 10rpx;
}