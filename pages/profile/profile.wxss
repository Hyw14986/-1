/* pages/profile/profile.wxss - 我的页面样式（治愈马卡龙风） */
.page {
  padding: 0 0 60rpx;
}

/* 返回主页按钮：白色药丸 + 柔和蓝调阴影 */
.back-home {
  display: inline-flex;
  align-items: center;
  margin: 28rpx 28rpx 0;
  padding: 12rpx 32rpx;
  background: #ffffff;
  border-radius: 44rpx;
  color: #5b9be8;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(127, 181, 245, 0.18);
}

.back-home-icon {
  margin-right: 8rpx;
  font-size: 28rpx;
}

.back-home.hover {
  opacity: 0.8;
}

/* 用户头部：柔蓝到薄荷绿渐变 + 大圆角 + 柔和阴影 */
.user-card {
  display: flex;
  align-items: center;
  margin: 28rpx 28rpx 0;
  padding: 52rpx 40rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #8fc4ff, #a8e6cf);
  box-shadow: 0 16rpx 40rpx rgba(127, 181, 245, 0.3);
}

.avatar-btn {
  background: transparent;
  padding: 0;
  margin: 0;
  width: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: none;
  line-height: 1.2;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 124rpx;
  height: 124rpx;
  border-radius: 50%;
  background: #ffffff;
  border: 6rpx solid #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(63, 78, 102, 0.16);
}

.avatar-tip {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.92);
  margin-top: 12rpx;
}

.user-info {
  flex: 1;
  margin-left: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.nickname-input {
  width: 100%;
  height: 80rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.32);
  border-radius: 24rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  margin-bottom: 22rpx;
}

/* 保存资料：药丸圆角 */
.save-btn {
  width: 260rpx;
  padding: 14rpx 0;
  font-size: 26rpx;
  border-radius: 50rpx;
  background: #ffffff;
  color: #5b9be8;
  box-shadow: 0 8rpx 20rpx rgba(127, 181, 245, 0.28);
}

.save-btn.hover {
  opacity: 0.85;
}

/* 区块卡片：使用 cute-card（大圆角 + 柔和阴影 + 四周留白） */
.section-card {
  margin: 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #3e4a5f;
  padding-top: 8rpx;
  margin-bottom: 8rpx;
}

/* 空状态：放大图标、增加上下间距 */
.section-card .empty {
  padding: 140rpx 0;
}

.section-card .empty-icon {
  font-size: 140rpx;
  margin-bottom: 28rpx;
}

/* 上报/评价条目 */
.report-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #eef4fc;
}

.report-item.hover {
  opacity: 0.75;
}

.report-item:last-child {
  border-bottom: none;
}

.report-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.report-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #3e4a5f;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 20rpx;
}

.report-status {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #5b9be8;
  background: rgba(127, 181, 245, 0.16);
  border-radius: 26rpx;
  padding: 4rpx 14rpx;
}

.report-meta {
  font-size: 22rpx;
  color: #9aa5b8;
  margin-top: 8rpx;
}

.report-content {
  font-size: 26rpx;
  color: #6b7a93;
  margin-top: 10rpx;
}

/* 开发工具 */
.dev-tip {
  font-size: 24rpx;
  color: #9aa5b8;
  margin-bottom: 20rpx;
}

.dev-btn {
  width: 100%;
  padding: 14rpx 0;
  font-size: 28rpx;
  border-radius: 50rpx;
}

.dev-btn.hover {
  opacity: 0.9;
}