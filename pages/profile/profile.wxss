/* pages/profile/profile.wxss - 我的页面「苹果白」简约版（业务绑定零改动，无渐变） */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 200rpx;
  background: #f5f5f7;
}

/* 返回主页 */
.back-home {
  display: inline-flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 12rpx 32rpx;
  background: #ffffff;
  border-radius: 44rpx;
  color: #007aff;
  font-size: 26rpx;
  font-weight: 600;
  border: 1rpx solid #efeff4;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.back-home-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
}

/* 用户信息卡 */
.user-card {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx;
  background: #ffffff;
  border: 1rpx solid #efeff4;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.avatar-btn {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  padding: 0;
  margin-right: 28rpx;
  background: transparent;
  border: none;
  border-radius: 50%;
  flex-shrink: 0;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.12);
  background: #f2f2f7;
}

.avatar-tip {
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 120rpx;
  text-align: center;
  padding: 4rpx 0;
  background: rgba(0, 0, 0, 0.5);
  color: #ffffff;
  font-size: 20rpx;
  border-radius: 0 0 60rpx 60rpx;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.nickname-input {
  width: 100%;
  height: 76rpx;
  background: #f2f2f7;
  border-radius: 16rpx;
  padding: 0 22rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
  box-sizing: border-box;
}

.save-btn {
  margin-top: 16rpx;
  display: inline-block;
  padding: 12rpx 40rpx;
  border-radius: 50rpx;
  background: #007aff;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 18rpx rgba(0, 122, 255, 0.26);
}

.ububble {
  position: absolute;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0, 122, 255, 0.08);
  animation: floatY 3.2s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  pointer-events: none;
}

.ububble.u1 { bottom: 20rpx; right: 90rpx; }
.ububble.u2 { top: 26rpx; right: 36rpx; width: 28rpx; height: 28rpx; animation-delay: 0.7s; }

@keyframes floatY {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

/* 查询次数 + 积分 */
.quota-card {
  margin-top: 24rpx;
}

.quota-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.quota-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.quota-title-ico {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
}

.quota-num {
  font-size: 26rpx;
  color: #6e6e73;
}

.quota-count {
  font-size: 44rpx;
  font-weight: 800;
  color: #007aff;
}

.quota-bar {
  margin-top: 18rpx;
  height: 16rpx;
  border-radius: 16rpx;
  background: #f2f2f7;
  overflow: hidden;
}

.quota-fill {
  height: 100%;
  border-radius: 16rpx;
  background: #007aff;
  transition: width 0.5s cubic-bezier(0.22, 1, 0.36, 1);
}

.quota-tip {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #aeaeb2;
  line-height: 1.5;
}

.checkin-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 26rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: #f2f2f7;
}

.checkin-left {
  display: flex;
  align-items: center;
}

.checkin-emoji {
  width: 44rpx;
  height: 44rpx;
  margin-right: 14rpx;
}

.checkin-text {
  display: flex;
  flex-direction: column;
}

.checkin-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.checkin-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #6e6e73;
}

.checkin-btn {
  flex-shrink: 0;
  padding: 12rpx 26rpx;
  border-radius: 40rpx;
  background: #007aff;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(0, 122, 255, 0.24);
}

.checkin-btn.done {
  background: #f2f2f7;
  color: #6e6e73;
  box-shadow: none;
}

.checkin-btn.loading {
  opacity: 0.6;
  animation: softPulse 1.6s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

.points-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.points-left {
  display: flex;
  align-items: center;
  flex: 1;
  font-size: 28rpx;
  color: #3a3a3c;
}

.points-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
}

.points-num {
  font-size: 40rpx;
  font-weight: 800;
  color: #1d1d1f;
  margin-right: 20rpx;
}

.points-btn {
  padding: 10rpx 22rpx;
  border-radius: 40rpx;
  background: #f2f2f7;
  color: #007aff;
  font-size: 22rpx;
  font-weight: 600;
}

/* 功能宫格 */
.grid-card {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
}

.card-head {
  width: 100%;
  display: flex;
  align-items: center;
  padding: 4rpx 0 10rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.card-head-ico {
  width: 34rpx;
  height: 34rpx;
  margin-right: 12rpx;
}

.grid-row {
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
}

.grid-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 26rpx 0;
  box-sizing: border-box;
}

.grid-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.gi-blue { background: #eaf3ff; }
.gi-pink { background: #fff0f5; }
.gi-mint { background: #e6f8f3; }
.gi-purple { background: #f3efff; }
.gi-gold { background: #fff7e6; }
.gi-sky { background: #eaf7f4; }

.grid-ico {
  width: 46rpx;
  height: 46rpx;
}

.grid-name {
  font-size: 24rpx;
  color: #3a3a3c;
}

/* 更多功能（开发中占位） */
.coming-card {
  margin-top: 24rpx;
}

.coming-head {
  padding-bottom: 14rpx;
}

.coming-badge {
  margin-left: auto;
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
  background: #fff7e6;
  color: #ff9500;
  font-size: 20rpx;
  font-weight: 600;
}

.coming-grid {
  width: 100%;
  display: flex;
  flex-wrap: wrap;
}

.coming-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 0 6rpx;
  box-sizing: border-box;
}

.coming-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
}

.ci-mint { background: #e6f8f3; }
.ci-sky { background: #eaf3ff; }
.ci-purple { background: #f3efff; }
.ci-gold { background: #fff7e6; }

.coming-ico {
  width: 42rpx;
  height: 42rpx;
}

.coming-name {
  font-size: 24rpx;
  color: #3a3a3c;
}

.coming-tag {
  margin-top: 8rpx;
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
  background: #f2f2f7;
  color: #aeaeb2;
  font-size: 18rpx;
}

.coming-footer {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f2f2f7;
  text-align: center;
  font-size: 22rpx;
  color: #aeaeb2;
}
/* 模块卡片 */
.section-card {
  margin-top: 24rpx;
}

.section-ico {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.section-card .empty {
  padding: 60rpx 0;
  color: #aeaeb2;
  font-size: 26rpx;
}

.report-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f2f2f7;
}

.report-item:last-child {
  border-bottom: none;
}

.report-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.report-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #1d1d1f;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.report-status {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-pass {
  color: #34c759;
  background: rgba(52, 199, 89, 0.12);
}

.status-pending {
  color: #ff9500;
  background: rgba(255, 149, 0, 0.12);
}

.status-reject {
  color: #ff3b30;
  background: rgba(255, 59, 48, 0.12);
}

.report-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6e6e73;
}

.report-content {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #3a3a3c;
  line-height: 1.6;
}

.report-reason {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #ff3b30;
}

.reason-ico {
  width: 26rpx;
  height: 26rpx;
  margin-right: 8rpx;
}

.report-fav-score {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #6e6e73;
}

.mini-star {
  width: 24rpx;
  height: 24rpx;
  margin-right: 6rpx;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-card {
  width: 620rpx;
  max-height: 80vh;
  overflow-y: auto;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 44rpx 36rpx 36rpx;
  position: relative;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
  animation: springPop 0.4s cubic-bezier(0.22, 1, 0.36, 1);
}

.modal-close {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #f2f2f7;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-close-ico {
  width: 26rpx;
  height: 26rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1d1d1f;
  text-align: center;
}

.about-lead {
  margin-top: 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: #007aff;
}

.about-body {
  margin-top: 24rpx;
}

.about-line {
  font-size: 26rpx;
  color: #3a3a3c;
  line-height: 1.8;
}

.about-facts {
  margin-top: 20rpx;
  background: #f2f2f7;
  border-radius: 20rpx;
  padding: 20rpx 22rpx;
}

.about-fact {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #3a3a3c;
  line-height: 1.8;
}

.fact-ico {
  width: 26rpx;
  height: 26rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.about-footer {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #aeaeb2;
}

.modal-btn {
  margin-top: 28rpx;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.modal-btn-primary {
  background: #007aff;
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(0, 122, 255, 0.26);
}

.modal-btn-ghost {
  background: #f2f2f7;
  color: #3a3a3c;
}

/* 打赏 */
.reward-title {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 800;
  color: #1d1d1f;
}

.reward-title-ico {
  width: 36rpx;
  height: 36rpx;
  margin-right: 10rpx;
}

.reward-sub {
  margin-top: 12rpx;
  text-align: center;
  font-size: 24rpx;
  color: #6e6e73;
}

.reward-qr {
  width: 360rpx;
  height: 360rpx;
  margin: 28rpx auto 0;
  display: block;
  border-radius: 20rpx;
  background: #f2f2f7;
}

.reward-tip {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #aeaeb2;
}

.reward-tip-warn {
  color: #ff9500;
}

.reward-actions {
  display: flex;
  margin-top: 28rpx;
}

.reward-actions .modal-btn {
  flex: 1;
  margin-top: 0;
}

.reward-actions .modal-btn-ghost {
  margin-right: 18rpx;
}
/* 给开发者留言 */
.dev-msg-card {
  margin-top: 24rpx;
}

.dev-msg-head {
  display: flex;
  align-items: center;
}

.dev-msg-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: #eaf3ff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.dev-msg-ico {
  width: 40rpx;
  height: 40rpx;
}

.dev-msg-text {
  flex: 1;
  min-width: 0;
}

.dev-msg-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.dev-msg-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #aeaeb2;
}

.dev-msg-arrow {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #007aff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  flex-shrink: 0;
  box-shadow: 0 6rpx 16rpx rgba(0, 122, 255, 0.26);
}

.dev-msg-arrow-ico {
  width: 30rpx;
  height: 30rpx;
}
/* 可展开区块头（我的上报/我的评价/我的收藏） */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 0;
}

.section-head .section-title {
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
}

.section-arrow {
  width: 32rpx;
  height: 32rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
  transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
}

.section-arrow.open {
  transform: rotate(180deg);
}

.section-body {
  margin-top: 20rpx;
}



/* 视觉升级覆盖：我的页渐变用户卡 + 玻璃宫格 */
.page {
  background: transparent;
}

.back-home {
  background: rgba(255, 255, 255, 0.82);
  border-color: rgba(255, 255, 255, 0.92);
  box-shadow: 0 12rpx 34rpx rgba(47, 87, 150, 0.1);
  color: #3478f6;
}

.user-card {
  background: linear-gradient(135deg, #4facfe 0%, #3478f6 52%, #7b6cf6 100%);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.34);
  box-shadow: 0 18rpx 48rpx rgba(52, 120, 246, 0.26);
}

.avatar {
  border-color: rgba(255, 255, 255, 0.9);
  box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.18);
}

.avatar-tip {
  background: linear-gradient(135deg, rgba(52, 120, 246, 0.95), rgba(123, 108, 246, 0.95));
}

.nickname-input {
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
}

.nickname-input::placeholder {
  color: rgba(255, 255, 255, 0.7);
}

.save-btn {
  background: #ffffff;
  color: #3478f6;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.14);
}

.ububble {
  background: rgba(255, 255, 255, 0.28);
}

.grid-card,
.section-card,
.coming-card,
.dev-msg-card {
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 16rpx 46rpx rgba(47, 87, 150, 0.1);
  backdrop-filter: blur(18rpx);
}

.gi-blue { background: linear-gradient(135deg, #eaf3ff, #dbeaff); }
.gi-pink { background: linear-gradient(135deg, #fff0f5, #ffe1ec); }
.gi-mint { background: linear-gradient(135deg, #e6f8f3, #d9f4ec); }
.gi-purple { background: linear-gradient(135deg, #f3efff, #e9e0ff); }
.gi-gold { background: linear-gradient(135deg, #fff7e6, #ffedc7); }
.gi-sky { background: linear-gradient(135deg, #eaf7f4, #d9f2ef); }

.modal-card {
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.22);
}

.modal-btn-primary {
  background: linear-gradient(135deg, #4facfe, #3478f6);
  color: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(52, 120, 246, 0.28);
}

.coming-badge {
  background: linear-gradient(135deg, #fff7e6, #ffedc7);
  color: #ff9500;
}



/* ============================================================
   我的页结构重排：双列 Bento 宫格
   ============================================================ */
.grid-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.grid-item {
  width: auto;
  background: #f8fbff;
  border: 1rpx solid #eef4ff;
  border-radius: 28rpx;
  padding: 26rpx 12rpx 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(47, 87, 150, 0.06);
}

.grid-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 26rpx;
}

.coming-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.coming-item {
  width: auto;
  background: #f8fbff;
  border: 1rpx solid #eef4ff;
  border-radius: 28rpx;
  padding: 24rpx 12rpx 18rpx;
  box-shadow: 0 8rpx 24rpx rgba(47, 87, 150, 0.06);
}

.section-card {
  border-radius: 32rpx;
}



/* ============================================================
   我的页最终规范：浅蓝低饱和、6宫格统一、统一留白
   ============================================================ */
.page {
  padding: 28rpx 32rpx 210rpx;
  background: transparent;
}

.back-home {
  padding: 10rpx 28rpx;
  background: #ffffff;
  color: #4096ff;
  border: 1rpx solid #dceeff;
  border-radius: 36rpx;
  box-shadow: none;
}

.user-card {
  padding: 34rpx 32rpx;
  background: linear-gradient(135deg, #eaf6ff 0%, #f8fcff 100%);
  color: #1f2937;
  border: 1rpx solid #dceeff;
  border-radius: 36rpx;
  box-shadow: 0 14rpx 40rpx rgba(64, 150, 255, 0.1);
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border: 4rpx solid #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(64, 150, 255, 0.12);
}

.avatar-tip {
  background: rgba(64, 150, 255, 0.88);
}

.nickname-input {
  height: 76rpx;
  background: #ffffff;
  color: #1f2937;
  border: 1rpx solid #dceeff;
  border-radius: 20rpx;
  padding: 0 24rpx;
}

.save-btn {
  margin-top: 16rpx;
  padding: 12rpx 38rpx;
  background: #4096ff;
