<!-- pages/profile/profile.wxml - 我的页面 -->
<view class="page">
  <!-- 返回主页 -->
  <view class="back-home" bindtap="goHome" hover-class="hover">
    <text class="back-home-icon">🏠</text>
    <text>返回主页</text>
  </view>

  <!-- 用户信息卡 -->
  <view class="user-card">
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image class="avatar" src="{{avatarTempPath || avatarUrl || defaultAvatar}}" mode="aspectFill" />
      <view class="avatar-tip">点击更换头像</view>
    </button>
    <view class="user-info">
      <input
        class="nickname-input"
        type="nickname"
        placeholder="点击填写昵称"
        placeholder-class="ph"
        value="{{nicknameInput}}"
        bindinput="onNicknameInput"
        maxlength="20"
      />
      <view class="save-btn" hover-class="hover" bindtap="saveProfile">保存资料</view>
    </view>
  </view>

  <!-- 今日剩余查询次数 -->
  <view class="quota-card">
    <view class="quota-title">🔋 今日剩余查询次数</view>
    <view class="quota-num"><text class="quota-count">{{remaining}}</text> / {{dailyLimit}}</view>
    <view class="quota-bar">
      <view class="quota-fill" style="width: {{remaining / dailyLimit * 100}}%"></view>
    </view>
    <view class="quota-tip">每次点击「开始寻找」消耗 1 次，每日 0 点自动重置</view>
  </view>

  <!-- 功能入口 -->
  <view class="cute-card menu-card">
    <view class="menu-item" hover-class="hover" bindtap="goSearchRecord">
      <view class="menu-left"><text class="menu-icon">📋</text><text>查询记录</text></view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" hover-class="hover" bindtap="showAbout">
      <view class="menu-left"><text class="menu-icon">💡</text><text>关于小程序</text></view>
      <view class="menu-arrow">›</view>
    </view>
  </view>

  <!-- 我的上报 -->
  <view class="cute-card section-card">
    <view class="section-title">📮 我上报的厕所（{{myToilets.length}}）</view>
    <view class="empty" wx:if="{{!loading && !myToilets.length}}">
      <view class="empty-icon">🚽</view>
      <view>还没有上报过～快去发现第一座公厕吧！</view>
    </view>
    <view
      class="report-item"
      wx:for="{{myToilets}}"
      wx:key="_id"
      data-id="{{item._id}}"
      bindtap="openToilet" hover-class="hover"
    >
      <view class="report-head">
        <view class="report-name">{{item.name}}</view>
        <view class="report-status {{item.auditStatus === 'pass' ? 'status-pass' : (item.auditStatus === 'reject' ? 'status-reject' : 'status-pending')}}">{{item.auditText}}</view>
      </view>
      <view class="report-meta">{{item.address}} · {{item.timeText}}</view>
    </view>
  </view>

  <!-- 我的评价 -->
  <view class="cute-card section-card">
    <view class="section-title">💬 我的评价（{{myComments.length}}）</view>
    <view class="empty" wx:if="{{!loading && !myComments.length}}">
      <view class="empty-icon">⭐</view>
      <view>还没有评价过～去给好公厕点个赞吧！</view>
    </view>
    <view
      class="report-item"
      wx:for="{{myComments}}"
      wx:key="_id"
      data-id="{{item.toiletId}}"
      bindtap="openToilet" hover-class="hover"
    >
      <view class="report-head">
        <view class="report-name">{{item.toiletName}}</view>
        <star-rating value="{{item.score}}" size="22" disabled="{{true}}" />
      </view>
      <view class="report-content" wx:if="{{item.content}}">{{item.content}}</view>
      <view class="report-meta">{{item.timeText}}</view>
    </view>
  </view>

  <!-- 我的收藏 -->
  <view class="cute-card section-card">
    <view class="section-title">❤️ 我的收藏（{{favorites.length}}）</view>
    <view class="empty" wx:if="{{!loading && !favorites.length}}">
      <view class="empty-icon">🤍</view>
      <view>还没有收藏～看到好公厕就收藏起来吧！</view>
    </view>
    <view
      class="report-item"
      wx:for="{{favorites}}"
      wx:key="_id"
      data-id="{{item._id}}"
      bindtap="openToilet" hover-class="hover"
    >
      <view class="report-head">
        <view class="report-name">{{item.name}}</view>
        <view class="report-fav-score">⭐ {{item.rating || '暂无'}} · {{item.ratingCount || 0}}人评</view>
      </view>
      <view class="report-meta">{{item.address}}</view>
    </view>
  </view>
</view>