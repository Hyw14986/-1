/* pages/index/index.wxss - 首页样式（治愈马卡龙风） */
.page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 240rpx;
  background: #fff8f3;
}

/* ---------- 顶部品牌区 ---------- */
.header {
  display: flex;
  align-items: center;
  padding: 12rpx 8rpx 24rpx;
}

.logo {
  width: 96rpx;
  height: 96rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #ffffff;
  padding: 10rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 20rpx rgba(127, 181, 245, 0.2);
}

.welcome-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #3e4a5f;
  letter-spacing: 2rpx;
}

.welcome-sub {
  font-size: 24rpx;
  color: #9aa5b8;
  margin-top: 8rpx;
}

/* ---------- 精准筛选栏 + 蹲位提示 ---------- */
.filter-bar {
  display: flex;
  align-items: center;
  padding: 0 8rpx 20rpx;
  overflow: hidden;
}

.filter-chip {
  flex-shrink: 0;
  padding: 12rpx 26rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  color: #7f8ba0;
  background: rgba(255, 255, 255, 0.7);
  border: 2rpx solid rgba(127, 181, 245, 0.3);
  margin-right: 16rpx;
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
}

.filter-chip.active {
  color: #ffffff;
  background: linear-gradient(135deg, #8fc4ff, #a8e6cf);
  border-color: transparent;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(127, 181, 245, 0.35);
}

.filter-chip.hover {
  opacity: 0.85;
}

.seat-chip {
  margin-left: auto;
  flex-shrink: 0;
  font-size: 22rpx;
  color: #5cbf9a;
  background: rgba(168, 230, 207, 0.35);
  border-radius: 26rpx;
  padding: 8rpx 18rpx;
  white-space: nowrap;
}

/* ---------- 核心功能区：地图卡片 ---------- */
.map-card {
  position: relative;
  height: 660rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #ffffff;
  box-shadow: 0 16rpx 44rpx rgba(127, 181, 245, 0.22);
}

.map-wrap {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 24rpx;
  overflow: hidden;
}

.map {
  width: 100%;
  height: 100%;
}

/* 地图工具按钮（右上角） */
.map-tools {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  z-index: 12;
  display: flex;
  flex-direction: column;
}

.tool-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.6);
  border: 2rpx solid rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  color: #5b9be8;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(127, 181, 245, 0.22);
  margin-bottom: 16rpx;
}

.tool-btn.hover {
  opacity: 0.75;
  transform: scale(0.94);
}

/* 加载结果提示 */
.data-tip {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  top: 24rpx;
  z-index: 12;
  max-width: 560rpx;
  font-size: 24rpx;
  color: #5b9be8;
  background: rgba(255, 255, 255, 0.94);
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 14rpx rgba(127, 181, 245, 0.2);
}

.data-tip-warn {
  color: #f591b8;
  background: rgba(255, 243, 248, 0.96);
}

/* 一键导航大按钮 */
.nav-now-btn {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 24rpx;
  z-index: 12;
  padding: 22rpx 64rpx;
  background: linear-gradient(135deg, #8fc4ff, #a8e6cf);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 50rpx;
  box-shadow: 0 12rpx 28rpx rgba(127, 181, 245, 0.45);
  white-space: nowrap;
}

.nav-now-btn.hover {
  transform: translateX(-50%) scale(0.96);
  opacity: 0.9;
}

/* ---------- 快捷操作区 ---------- */
.quick-actions {
  display: flex;
  justify-content: space-around;
  margin-top: 40rpx;
  padding: 0 40rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quick-item.hover {
  opacity: 0.85;
  transform: scale(0.96);
}

.quick-circle {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 68rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 28rpx rgba(127, 181, 245, 0.3);
}

.quick-green {
  background: linear-gradient(135deg, #a8e6cf, #7ed3ac);
}

.quick-orange {
  background: linear-gradient(135deg, #ffc9dc, #ffb8d1);
}

.quick-mint {
  background: linear-gradient(135deg, #8fc4ff, #6f9fe8);
}

.quick-label {
  margin-top: 14rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #3e4a5f;
}

/* ---------- IP 形象：洗手小水滴 ---------- */
.mascot {
  position: absolute;
  right: 0;
  bottom: 280rpx;
  width: 120rpx;
  height: 120rpx;
  z-index: 8;
}

/* ---------- 底部厕所简要卡片 ---------- */
.toilet-card {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 580rpx;
  z-index: 25;
  margin: 0;
  border-radius: 36rpx;
  box-shadow: 0 16rpx 40rpx rgba(127, 181, 245, 0.24);
  padding: 32rpx;
  background: #ffffff;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #3e4a5f;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-rating {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.rating-num {
  font-size: 24rpx;
  color: #ffc94d;
  margin-left: 8rpx;
}

.card-dist {
  font-size: 24rpx;
  color: #9aa5b8;
  margin-left: 16rpx;
}

.card-tags {
  margin-top: 16rpx;
}

.card-address {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #9aa5b8;
  word-break: break-all;
}

.card-actions {
  display: flex;
  margin-top: 24rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #5b9be8;
  border: 2rpx solid rgba(127, 181, 245, 0.5);
  border-radius: 44rpx;
  padding: 16rpx 0;
  margin-right: 20rpx;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
}

.action-btn:last-child {
  margin-right: 0;
}

.action-btn.hover {
  opacity: 0.85;
}

.action-primary {
  background: linear-gradient(135deg, #8fc4ff, #a8e6cf);
  color: #ffffff;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(127, 181, 245, 0.4);
}

/* ---------- 悬浮式底部菜单 ---------- */
.tab-dock {
  position: fixed;
  left: 60rpx;
  right: 60rpx;
  bottom: 32rpx;
  z-index: 40;
  display: flex;
  justify-content: space-around;
  align-items: center;
  height: 128rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(30rpx);
  -webkit-backdrop-filter: blur(30rpx);
  border-radius: 72rpx;
  box-shadow: 0 16rpx 40rpx rgba(127, 181, 245, 0.26);
}

.dock-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 170rpx;
}

.dock-item.hover {
  opacity: 0.8;
}

.dock-icon-wrap {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dock-active .dock-icon-wrap {
  background: rgba(127, 181, 245, 0.2);
}

.dock-icon {
  width: 52rpx;
  height: 52rpx;
}

.dock-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9aa5b8;
}

.dock-active .dock-label {
  color: #5b9be8;
  font-weight: 700;
  background: rgba(127, 181, 245, 0.16);
  border-radius: 24rpx;
  padding: 4rpx 20rpx;
}

/* ---------- 引导遮罩层 ---------- */
.locate-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 50;
  background: rgba(255, 248, 243, 0.96);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.mask-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #3e4a5f;
  margin-bottom: 16rpx;
}

.mask-desc {
  font-size: 26rpx;
  color: #9aa5b8;
  margin-bottom: 48rpx;
  padding: 0 60rpx;
  text-align: center;
}

.mask-btn {
  width: 360rpx;
}

.mask-btn.hover {
  opacity: 0.9;
  transform: scale(0.98);
}

.mask-btn-plain {
  background: #ffffff;
  color: #5b9be8;
  border: 2rpx solid #7fb5f5;
  margin-top: 20rpx;
  box-shadow: none;
}

.mask-link {
  margin-top: 28rpx;
  font-size: 26rpx;
  color: #5b9be8;
  text-decoration: underline;
}