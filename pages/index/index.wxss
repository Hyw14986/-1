/* pages/index/index.wxss - 首页「苹果白」简约版（业务绑定零改动，无渐变，无 emoji） */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 190rpx;
  background: #f5f5f7;
}

/* ============ 顶部 Hero 卡片 ============ */
.hero {
  position: relative;
  overflow: hidden;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 30rpx 30rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid #efeff4;
  color: #1d1d1f;
}

.hero-top {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.hero-title {
  display: flex;
  align-items: center;
  font-size: 44rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.hero-title-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 12rpx;
}

.hero-sub {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #6e6e73;
}

.radius-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 26rpx;
}

.radius-picker {
  flex-shrink: 0;
}

.radius-select {
  display: flex;
  align-items: center;
  padding: 14rpx 26rpx;
  border-radius: 40rpx;
  background: #f2f2f7;
  color: #1d1d1f;
  font-size: 26rpx;
  font-weight: 600;
}

.chevron-sm {
  width: 22rpx;
  height: 22rpx;
  margin-left: 8rpx;
}

.radius-text {
  font-size: 24rpx;
  color: #6e6e73;
}

.start-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  background: #007aff;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 50rpx;
  padding: 24rpx 0;
  box-shadow: 0 10rpx 26rpx rgba(0, 122, 255, 0.3);
  transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.2s ease-out;
}

.start-btn.loading {
  opacity: 0.92;
  animation: softPulse 1.6s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

.start-btn-ico {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
}

.hero-foot {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 24rpx;
}

.showall-btn {
  display: flex;
  align-items: center;
  padding: 10rpx 24rpx;
  border-radius: 40rpx;
  background: #f2f2f7;
  color: #007aff;
  font-size: 24rpx;
  font-weight: 600;
  transition: background 0.2s cubic-bezier(0.22, 1, 0.36, 1), color 0.2s ease-out;
}

.showall-ico {
  width: 26rpx;
  height: 26rpx;
  margin-right: 8rpx;
}

.showall-btn.active {
  background: #007aff;
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(0, 122, 255, 0.28);
}

/* Hero 装饰泡泡（纯色浅灰圆点，非 emoji） */
.bubble {
  position: absolute;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: rgba(0, 122, 255, 0.08);
  animation: floatY 3.4s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  pointer-events: none;
}

.bubble.b1 { top: 24rpx; right: 150rpx; animation-delay: 0s; }
.bubble.b2 { top: 96rpx; right: 44rpx; width: 30rpx; height: 30rpx; animation-delay: 0.7s; }
.bubble.b3 { bottom: 26rpx; right: 210rpx; width: 34rpx; height: 34rpx; background: rgba(0, 122, 255, 0.06); animation-delay: 1.4s; }

@keyframes floatY {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-14rpx); }
}

/* ============ 定位提示条 ============ */
.locate-banner {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: #ffffff;
  border: 1rpx solid #efeff4;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.banner-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.banner-pin {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
}

.banner-text {
  flex: 1;
  font-size: 26rpx;
  color: #6e6e73;
}

.banner-close {
  width: 48rpx;
  height: 48rpx;
  margin-left: 16rpx;
  border-radius: 50%;
  background: #f2f2f7;
  display: flex;
  align-items: center;
  justify-content: center;
}

.banner-close-ico {
  width: 24rpx;
  height: 24rpx;
}

.banner-actions {
  margin-top: 14rpx;
}

.banner-btn {
  display: inline-block;
  padding: 10rpx 28rpx;
  border-radius: 40rpx;
  background: #007aff;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(0, 122, 255, 0.24);
}

/* ============ 筛选胶囊 ============ */
.filter-bar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 22rpx;
  gap: 14rpx;
}

.filter-chip {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: 40rpx;
  background: #ffffff;
  color: #3a3a3c;
  font-size: 24rpx;
  font-weight: 600;
  border: 1rpx solid #efeff4;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
  transition: background 0.22s cubic-bezier(0.22, 1, 0.36, 1), color 0.22s ease-out, transform 0.18s cubic-bezier(0.22, 1, 0.36, 1);
}

.chip-ico {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.chip-blue.active,
.chip-purple.active,
.chip-pink.active,
.chip-mint.active {
  background: #007aff;
  color: #ffffff;
  border-color: #007aff;
  box-shadow: 0 6rpx 18rpx rgba(0, 122, 255, 0.26);
}

.filter-reset {
  color: #6e6e73;
}

/* ============ 地图卡片 ============ */
.map-shell {
  position: relative;
  margin-top: 22rpx;
  height: calc(100vh - 720rpx);
  min-height: 560rpx;
  max-height: 900rpx;
  border-radius: 32rpx;
  overflow: hidden;
  border: 2rpx solid #ffffff;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
  background: #eaf0f7;
}

.map {
  width: 100%;
  height: 100%;
}

.map-tip {
  position: absolute;
  left: 50%;
  top: 20rpx;
  transform: translateX(-50%);
  background: rgba(255, 255, 255, 0.96);
  color: #6e6e73;
  font-size: 24rpx;
  border-radius: 40rpx;
  padding: 10rpx 26rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  white-space: nowrap;
  z-index: 25;
}

.loading-tip {
  display: flex;
  align-items: center;
}

.tip-ico {
  width: 26rpx;
  height: 26rpx;
  margin-right: 10rpx;
}

.map-tip-warn {
  color: #ff9500;
  background: rgba(255, 247, 237, 0.97);
}

.locate-fab {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #ffffff;
  border: 1rpx solid #efeff4;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.12);
  z-index: 30;
  transition: bottom 0.3s cubic-bezier(0.22, 1, 0.36, 1), transform 0.18s cubic-bezier(0.22, 1, 0.36, 1);
}

.locate-fab-ico {
  width: 40rpx;
  height: 40rpx;
}

.locate-fab.up {
  bottom: 240rpx;
}

/* ============ marker 气泡卡片 ============ */
.bubble-card {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 56rpx;
  z-index: 40;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 26rpx 28rpx;
  box-shadow: 0 12rpx 34rpx rgba(0, 0, 0, 0.12);
  border: 1rpx solid #efeff4;
  animation: popIn 0.3s cubic-bezier(0.22, 1, 0.36, 1);
}

@keyframes popIn {
  from { transform: translateY(-16rpx) scale(0.96); opacity: 0; }
  to { transform: translateY(0) scale(1); opacity: 1; }
}

.bubble-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bubble-name {
  flex: 1;
  font-size: 32rpx;
  font-weight: 700;
  color: #1d1d1f;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bubble-close {
  width: 48rpx;
  height: 48rpx;
  margin-left: 16rpx;
  border-radius: 50%;
  background: #f2f2f7;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bubble-close-ico {
  width: 24rpx;
  height: 24rpx;
}

.bubble-tags {
  margin-top: 14rpx;
}

.bubble-meta {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6e6e73;
}

.meta-star {
  width: 26rpx;
  height: 26rpx;
  margin-right: 6rpx;
}

.bubble-actions {
  display: flex;
  margin-top: 20rpx;
}

.bubble-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  padding: 14rpx 0;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #007aff;
  background: #f2f2f7;
  margin-right: 20rpx;
}

.bubble-btn:last-child {
  margin-right: 0;
}

.bubble-primary {
  background: #007aff;
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(0, 122, 255, 0.26);
}

.btn-ico {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

/* ============ 底部托盘 ============ */
.tray {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  z-index: 20;
  background: rgba(255, 255, 255, 0.98);
  border-radius: 28rpx;
  padding: 24rpx 26rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.1);
  border: 1rpx solid #efeff4;
  max-height: 460rpx;
  display: flex;
  flex-direction: column;
}

.tray-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tray-count {
  font-size: 28rpx;
  font-weight: 700;
  color: #1d1d1f;
  flex: 1;
}

.expand-btn {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  padding: 8rpx 24rpx;
  border-radius: 36rpx;
  background: #f2f2f7;
  color: #007aff;
  font-size: 24rpx;
  font-weight: 600;
}

.expand-ico {
  width: 22rpx;
  height: 22rpx;
  margin-right: 6rpx;
}

.expand-btn.disabled {
  opacity: 0.4;
  color: #aeaeb2;
  pointer-events: none;
}

.nearest-line {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 12rpx 18rpx;
  border-radius: 20rpx;
  background: #f2f2f7;
}

.nearest-ico {
  width: 26rpx;
  height: 26rpx;
  margin-right: 10rpx;
}

.nearest-text {
  font-size: 24rpx;
  color: #3a3a3c;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bottom-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #aeaeb2;
}

.filter-empty-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #ff9500;
}

.toilet-list {
  max-height: 320rpx;
  margin-top: 16rpx;
}

.list-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f2f7;
}

.list-item:last-child {
  border-bottom: none;
}

.item-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.item-name-row {
  display: flex;
  align-items: center;
}

.item-emoji {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1d1d1f;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nearest-badge {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: 24rpx;
  background: rgba(255, 149, 0, 0.12);
  color: #ff9500;
  font-size: 20rpx;
  font-weight: 600;
}

.badge-ico {
  width: 20rpx;
  height: 20rpx;
  margin-right: 4rpx;
}

.item-tags {
  margin-top: 10rpx;
}

.item-meta {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #6e6e73;
}

.item-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: space-between;
  flex-shrink: 0;
}

.item-dist {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #6e6e73;
}

.dist-ico {
  width: 22rpx;
  height: 22rpx;
  margin-right: 6rpx;
}

.item-nav {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  padding: 8rpx 20rpx;
  border-radius: 32rpx;
  background: #007aff;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(0, 122, 255, 0.24);
}

/* ============ 空状态 ============ */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 20rpx;
}

.empty-state .empty-icon {
  width: 110rpx;
  height: 110rpx;
}

.empty-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #aeaeb2;
  text-align: center;
}

/* ============ 0 结果空状态弹窗 ============ */
.empty-modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 180;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-modal {
  width: 600rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  text-align: center;
  box-shadow: 0 24rpx 70rpx rgba(0, 0, 0, 0.18);
  animation: springPop 0.4s cubic-bezier(0.22, 1, 0.36, 1);
}

.empty-modal-icon {
  width: 120rpx;
  height: 120rpx;
}

.empty-modal-title {
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.empty-modal-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #6e6e73;
}

.empty-modal-actions {
  display: flex;
  margin-top: 36rpx;
}

.empty-modal-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  padding: 20rpx 0;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #007aff;
  background: #f2f2f7;
  margin-right: 20rpx;
}

.empty-modal-btn:last-child {
  margin-right: 0;
}

.empty-primary {
  background: #007aff;
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(0, 122, 255, 0.28);
}

/* ============ 详情底部弹窗 ============ */
.detail-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  /* 底部留出 tabbar（100rpx + 安全区）高度，弹窗不再被底部导航遮挡 */
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

.detail-card {
  width: 100%;
  height: calc(86vh - 100rpx - env(safe-area-inset-bottom));
  overflow-y: scroll;
  -webkit-overflow-scrolling: touch;
  flex-shrink: 0;
  background: #f5f5f7;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -12rpx 40rpx rgba(0, 0, 0, 0.14);
  animation: sheetUp 0.35s cubic-bezier(0.22, 1, 0.36, 1);
}

.detail-card-pad {
  padding: 36rpx 32rpx 60rpx;
}

@keyframes sheetUp {
  from { transform: translateY(60%); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.detail-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.detail-name {
  flex: 1;
  font-size: 38rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.detail-close {
  width: 56rpx;
  height: 56rpx;
  margin-left: 16rpx;
  border-radius: 50%;
  background: #f2f2f7;
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-close-ico {
  width: 28rpx;
  height: 28rpx;
}

.detail-tags {
  margin-top: 22rpx;
}

.detail-scores {
  margin-top: 20rpx;
  background: #eef4ff;
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
  font-size: 24rpx;
  color: #007aff;
  line-height: 1.6;
}

.detail-rating {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #6e6e73;
}

.detail-note {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #f2f2f7;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #3a3a3c;
  line-height: 1.6;
}
.detail-photos {
  display: flex;
  margin-top: 20rpx;
  gap: 16rpx;
  overflow-x: auto;
  padding-bottom: 4rpx;
}

.detail-photo {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  background: #f2f2f7;
}

.detail-actions {
  display: flex;
  margin-top: 28rpx;
}

.detail-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  padding: 20rpx 0;
  border-radius: 50rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #007aff;
  background: #ffffff;
  border: 1rpx solid #efeff4;
  margin-right: 18rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.detail-btn:last-child {
  margin-right: 0;
}

.detail-primary {
  background: #007aff;
  color: #ffffff;
  border-color: #007aff;
  box-shadow: 0 8rpx 20rpx rgba(0, 122, 255, 0.28);
}

/* ============ 写评价 ============ */
.comment-form {
  margin-top: 28rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #efeff4;
}

.star-row {
  display: flex;
  align-items: center;
}

.star {
  width: 52rpx;
  height: 52rpx;
  margin-right: 8rpx;
  transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1);
}

.comment-input {
  width: 100%;
  margin-top: 16rpx;
  padding: 18rpx 22rpx;
  font-size: 26rpx;
  color: #1d1d1f;
  box-sizing: border-box;
}

.submit-comment-btn {
  margin-top: 18rpx;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 50rpx;
  background: #007aff;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 18rpx rgba(0, 122, 255, 0.24);
}

.submit-comment-btn.disabled {
  opacity: 0.5;
}

.comment-form-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1d1d1f;
  margin-bottom: 18rpx;
}

.cscore-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.cscore-name {
  font-size: 26rpx;
  color: #3a3a3c;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.comment-total {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #007aff;
  font-weight: 600;
}

/* ============ 历史评价 ============ */
.comment-list {
  margin-top: 28rpx;
}

.comment-item {
  display: flex;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #efeff4;
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 18rpx;
  flex-shrink: 0;
  background: #f2f2f7;
}

