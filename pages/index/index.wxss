/* pages/index/index.wxss - 首页样式（温馨可爱扁平插画风） */
.page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 240rpx;
  background: #fff9ef;
}

/* ---------- 顶部品牌区 ---------- */
.header {
  display: flex;
  align-items: center;
  padding: 12rpx 8rpx 24rpx;
}

.logo {
  width: 96rpx;
  height: 96rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.welcome-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2c3e50;
  letter-spacing: 2rpx;
}

.welcome-sub {
  font-size: 24rpx;
  color: #7f8c8d;
  margin-top: 8rpx;
}

/* ---------- 核心功能区：地图卡片 ---------- */
.map-card {
  position: relative;
  height: 660rpx;
  border-radius: 36rpx;
  overflow: hidden;
  background: #ffffff;
  box-shadow: 0 14rpx 40rpx rgba(255, 169, 77, 0.22);
}

.map-wrap {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 36rpx;
  overflow: hidden;
}

.map {
  width: 100%;
  height: 100%;
}

/* 地图工具按钮（右上角） */
.map-tools {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  z-index: 12;
  display: flex;
  flex-direction: column;
}

.tool-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  color: #ffa94d;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(255, 169, 77, 0.22);
  margin-bottom: 16rpx;
}

.tool-btn.hover {
  opacity: 0.75;
}

/* 加载结果提示 */
.data-tip {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  top: 24rpx;
  z-index: 12;
  max-width: 560rpx;
  font-size: 24rpx;
  color: #ffa94d;
  background: rgba(255, 255, 255, 0.94);
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 14rpx rgba(255, 169, 77, 0.2);
}

.data-tip-warn {
  color: #e8833a;
  background: rgba(255, 243, 224, 0.95);
}

/* 一键导航大按钮 */
.nav-now-btn {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 24rpx;
  z-index: 12;
  padding: 22rpx 64rpx;
  background: linear-gradient(135deg, #ffb85c, #ffa94d);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 50rpx;
  box-shadow: 0 10rpx 24rpx rgba(255, 169, 77, 0.5);
  white-space: nowrap;
}

.nav-now-btn.hover {
  transform: translateX(-50%) scale(0.96);
  opacity: 0.9;
}

/* ---------- 快捷操作区 ---------- */
.quick-actions {
  display: flex;
  justify-content: space-around;
  margin-top: 36rpx;
  padding: 0 48rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quick-item.hover {
  opacity: 0.85;
  transform: scale(0.97);
}

.quick-circle {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 68rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 24rpx rgba(44, 62, 80, 0.14);
}

.quick-green {
  background: linear-gradient(135deg, #8fd9a8, #6ecf96);
}

.quick-orange {
  background: linear-gradient(135deg, #ffc06b, #ffa94d);
}

.quick-label {
  margin-top: 14rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #2c3e50;
}

/* ---------- IP 形象：洗手小水滴 ---------- */
.mascot {
  position: absolute;
  right: 0;
  bottom: 280rpx;
  width: 120rpx;
  height: 120rpx;
  z-index: 8;
}

/* ---------- 底部厕所简要卡片 ---------- */
.toilet-card {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 580rpx;
  z-index: 25;
  margin: 0;
  border-radius: 32rpx;
  box-shadow: 0 12rpx 36rpx rgba(255, 169, 77, 0.25);
  padding: 28rpx;
  background: #ffffff;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c3e50;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-rating {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.rating-num {
  font-size: 24rpx;
  color: #ffb400;
  margin-left: 8rpx;
}

.card-dist {
  font-size: 24rpx;
  color: #7f8c8d;
  margin-left: 16rpx;
}

.card-tags {
  margin-top: 16rpx;
}

.card-actions {
  display: flex;
  margin-top: 24rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #ffa94d;
  border: 2rpx solid #ffa94d;
  border-radius: 40rpx;
  padding: 16rpx 0;
  margin-right: 20rpx;
  background: #ffffff;
}

.action-btn:last-child {
  margin-right: 0;
}

.action-primary {
  background: linear-gradient(135deg, #ffb85c, #ffa94d);
  color: #ffffff;
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(255, 169, 77, 0.4);
}

/* ---------- 悬浮式底部菜单 ---------- */
.tab-dock {
  position: fixed;
  left: 60rpx;
  right: 60rpx;
  bottom: 32rpx;
  z-index: 40;
  display: flex;
  justify-content: space-around;
  align-items: center;
  height: 128rpx;
  background: #ffffff;
  border: 2rpx solid rgba(255, 169, 77, 0.18);
  border-radius: 72rpx;
  box-shadow: 0 12rpx 32rpx rgba(255, 169, 77, 0.28);
}

.dock-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 170rpx;
}

.dock-icon-wrap {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dock-active .dock-icon-wrap {
  background: rgba(255, 169, 77, 0.2);
}

.dock-icon {
  width: 52rpx;
  height: 52rpx;
}

.dock-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9aa5b1;
}

.dock-active .dock-label {
  color: #ffa94d;
  font-weight: 700;
  background: rgba(255, 169, 77, 0.16);
  border-radius: 22rpx;
  padding: 4rpx 20rpx;
}

/* ---------- 引导遮罩层 ---------- */
.locate-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 50;
  background: rgba(255, 249, 239, 0.95);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.mask-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 16rpx;
}

.mask-desc {
  font-size: 26rpx;
  color: #7f8c8d;
  margin-bottom: 48rpx;
  padding: 0 60rpx;
  text-align: center;
}

.mask-btn {
  width: 360rpx;
}

.mask-btn-plain {
  background: #ffffff;
  color: #ffa94d;
  border: 2rpx solid #ffa94d;
  margin-top: 20rpx;
  box-shadow: none;
}

.mask-link {
  margin-top: 28rpx;
  font-size: 26rpx;
  color: #ffa94d;
  text-decoration: underline;
}