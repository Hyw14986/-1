/* FINAL_START_BTN_MOTION - dynamic tactile start button */
.start-btn {
  position: relative;
  overflow: hidden;
}

.start-btn::before,
.start-btn::after {
  content: '';
  position: absolute;
  display: block;
  pointer-events: none;
  z-index: 0;
}

.start-btn::before {
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  border-radius: inherit;
  background: radial-gradient(120rpx 60rpx at 50% 50%, rgba(255, 255, 255, 0.38), rgba(255, 255, 255, 0) 70%);
  opacity: 0;
  animation: startBtnGlow 2.6s ease-in-out infinite;
}

.start-btn::after {
  top: -30%;
  left: -60%;
  width: 36%;
  height: 160%;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.34), rgba(255, 255, 255, 0));
  transform: rotate(16deg);
  animation: startBtnShine 3.2s ease-in-out infinite;
}

.start-btn > image,
.start-btn > text {
  position: relative;
  z-index: 1;
}

.start-btn.hover {
  transform: scale(0.96);
  background: #2f7ff0;
  box-shadow: 0 10rpx 24rpx rgba(47, 127, 240, 0.26);
}

.start-btn.loading::before {
  animation: startBtnGlowLoading 1.1s ease-in-out infinite;
}

.start-btn-ico.spin {
  animation: startBtnSpin 0.9s linear infinite;
}

@keyframes startBtnGlow {
  0%, 100% { opacity: 0; transform: scale(0.9); }
  50% { opacity: 1; transform: scale(1.06); }
}

@keyframes startBtnGlowLoading {
  0%, 100% { opacity: 0.35; transform: scale(0.9); }
  50% { opacity: 1; transform: scale(1.12); }
}

@keyframes startBtnShine {
  0% { left: -60%; }
  55%, 100% { left: 130%; }
}

@keyframes startBtnSpin {
  to { transform: rotate(360deg); }
}
