/* pages/index/index.wxss - 首页地图页样式 */
.page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

.map {
  width: 100%;
  height: 100%;
}

/* 列表视图切换按钮 */
.switch-btn {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  z-index: 10;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  color: #29B6F6;
  font-size: 26rpx;
  padding: 14rpx 26rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
}

.switch-icon {
  margin-right: 8rpx;
  font-size: 30rpx;
}

/* 回到定位按钮 */
.locate-btn {
  position: absolute;
  right: 24rpx;
  bottom: 300rpx;
  z-index: 10;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #FFFFFF;
  color: #29B6F6;
  font-size: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
}

.locate-btn.hover {
  opacity: 0.7;
}

/* 底部公厕简要卡片 */
.toilet-card {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 40rpx;
  z-index: 20;
  padding: 28rpx;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-rating {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.rating-num {
  font-size: 24rpx;
  color: #FFB400;
  margin-left: 8rpx;
}

.card-dist {
  font-size: 24rpx;
  color: #9AA5B1;
  margin-left: 16rpx;
}

.card-tags {
  margin-top: 16rpx;
}

.card-actions {
  display: flex;
  margin-top: 24rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #29B6F6;
  border: 2rpx solid #29B6F6;
  border-radius: 40rpx;
  padding: 16rpx 0;
  margin-right: 20rpx;
}

.action-btn:last-child {
  margin-right: 0;
}

.action-primary {
  background: #29B6F6;
  color: #FFFFFF;
  border: none;
}

/* 定位失败引导层 */
.locate-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 30;
  background: rgba(255, 255, 255, 0.92);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.mask-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.mask-desc {
  font-size: 26rpx;
  color: #9AA5B1;
  margin-bottom: 48rpx;
}

.mask-btn {
  width: 360rpx;
}

.mask-link {
  margin-top: 28rpx;
  font-size: 26rpx;
  color: #29B6F6;
  text-decoration: underline;
}
