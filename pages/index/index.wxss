/* pages/index/index.wxss - 附近厕所主页面（可爱马卡龙风） */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 180rpx;
  background: #f7faff;
}

/* ---------- 顶部 ---------- */
.top-bar {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(116, 185, 255, 0.16);
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2c3e50;
}

.radius-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.radius-picker {
  flex-shrink: 0;
}

.radius-select {
  padding: 12rpx 24rpx;
  border-radius: 40rpx;
  background: #f0f7ff;
  color: #74b9ff;
  font-size: 26rpx;
  font-weight: 600;
  border: 2rpx solid rgba(116, 185, 255, 0.35);
}

.radius-text {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #7f8c8d;
  flex: 1;
}

.start-btn {
  flex-shrink: 0;
  padding: 16rpx 36rpx;
  border-radius: 50rpx;
  background: linear-gradient(135deg, #74b9ff, #a8e6cf);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(116, 185, 255, 0.4);
}

.start-btn.disabled {
  opacity: 0.6;
}

.start-btn.hover {
  opacity: 0.85;
  transform: scale(0.96);
}

.quota-text {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #ff9fb2;
}

/* ---------- 定位提示条 ---------- */
.locate-banner {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid rgba(116, 185, 255, 0.3);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(116, 185, 255, 0.18);
}

.banner-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.banner-text {
  font-size: 26rpx;
  color: #7f8c8d;
}

.banner-close {
  width: 48rpx;
  height: 48rpx;
  margin-left: 16rpx;
  border-radius: 50%;
  background: rgba(116, 185, 255, 0.15);
  color: #74b9ff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.banner-close.hover {
  opacity: 0.8;
}

.banner-actions {
  margin-top: 16rpx;
}

.banner-btn {
  text-align: center;
  font-size: 26rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #74b9ff, #a8e6cf);
  border-radius: 44rpx;
  padding: 14rpx 0;
}

.banner-btn.hover {
  opacity: 0.85;
}

/* ---------- 筛选栏 ---------- */
.filter-bar {
  display: flex;
  margin-top: 20rpx;
  overflow: hidden;
}

.filter-chip {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  color: #7f8c8d;
  background: rgba(255, 255, 255, 0.85);
  border: 2rpx solid rgba(116, 185, 255, 0.3);
  margin-right: 16rpx;
}

.filter-chip.active {
  color: #ffffff;
  background: linear-gradient(135deg, #74b9ff, #a8e6cf);
  border-color: transparent;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(116, 185, 255, 0.35);
}

/* ---------- 地图卡片 ---------- */
.map-card {
  position: relative;
  height: calc(100vh - 560rpx);
  min-height: 560rpx;
  max-height: 900rpx;
  margin-top: 20rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: #ffffff;
  box-shadow: 0 16rpx 44rpx rgba(116, 185, 255, 0.2);
}

.map {
  width: 100%;
  height: 100%;
}

.map-tip {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  top: 20rpx;
  max-width: 560rpx;
  font-size: 24rpx;
  color: #74b9ff;
  background: rgba(255, 255, 255, 0.94);
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 14rpx rgba(116, 185, 255, 0.2);
}

.map-tip-warn {
  color: #f591b8;
}

/* ---------- 底部卡片 ---------- */
.bottom-card {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(116, 185, 255, 0.16);
}

.bottom-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bottom-count {
  font-size: 30rpx;
  font-weight: 700;
  color: #2c3e50;
}

.expand-btn {
  padding: 10rpx 26rpx;
  border-radius: 40rpx;
  background: #f0f7ff;
  color: #74b9ff;
  font-size: 26rpx;
}

.expand-btn.hover {
  opacity: 0.8;
}

.toilet-list {
  max-height: 480rpx;
  margin-top: 16rpx;
}

.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 8rpx;
  border-bottom: 2rpx solid rgba(116, 185, 255, 0.12);
}

.list-item.hover {
  background: rgba(116, 185, 255, 0.06);
}

.item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2c3e50;
}

.item-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.tag {
  font-size: 20rpx;
  color: #74b9ff;
  background: #f0f7ff;
  border-radius: 20rpx;
  padding: 4rpx 14rpx;
  margin-right: 10rpx;
  margin-top: 6rpx;
}

.item-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7f8c8d;
}

.item-dist {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #74b9ff;
  font-weight: 600;
}

/* ---------- 空状态 ---------- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 80rpx;
}

.empty-icon {
  font-size: 96rpx;
}

.empty-text {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #7f8c8d;
}

/* ---------- 详情弹窗 ---------- */
.detail-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 60;
  background: rgba(44, 62, 80, 0.5);
  display: flex;
  align-items: flex-end;
}

.detail-card {
  width: 100%;
  background: #f7faff;
  border-radius: 36rpx 36rpx 0 0;
  padding: 32rpx 28rpx 60rpx;
  max-height: 82vh;
  overflow-y: auto;
  box-sizing: border-box;
}

.detail-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.detail-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #2c3e50;
  flex: 1;
}

.detail-close {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(116, 185, 255, 0.15);
  color: #74b9ff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.tag-source {
  background: #a8e6cf;
  color: #2c3e50;
}

.detail-rating {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #7f8c8d;
}

.detail-actions {
  display: flex;
  margin-top: 24rpx;
}

.detail-btn {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #74b9ff;
  background: #ffffff;
  border: 2rpx solid rgba(116, 185, 255, 0.5);
  border-radius: 44rpx;
  padding: 16rpx 0;
  margin-right: 16rpx;
}

.detail-btn:last-child {
  margin-right: 0;
}

.detail-btn.hover {
  opacity: 0.8;
}

.detail-primary {
  background: linear-gradient(135deg, #74b9ff, #a8e6cf);
  color: #ffffff;
  border: none;
}

/* 评价表单 */
.comment-form {
  margin-top: 28rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx;
}

.star-row {
  display: flex;
  font-size: 44rpx;
}

.star {
  margin-right: 10rpx;
}

.comment-input {
  width: 100%;
  height: 140rpx;
  margin-top: 16rpx;
  background: #f0f7ff;
  border-radius: 16rpx;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: 26rpx;
}

.submit-comment-btn {
  margin-top: 16rpx;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 50rpx;
  background: linear-gradient(135deg, #74b9ff, #a8e6cf);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}

.submit-comment-btn.disabled {
  opacity: 0.6;
}

.submit-comment-btn.hover {
  opacity: 0.85;
}

/* 评价列表 */
.comment-list {
  margin-top: 28rpx;
}

.comment-item {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.comment-head {
  display: flex;
  justify-content: space-between;
}

.comment-user {
  font-size: 26rpx;
  font-weight: 600;
  color: #2c3e50;
}

.comment-score {
  font-size: 24rpx;
  color: #ffc94d;
}

.comment-content {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7f8c8d;
}

.comment-empty {
  text-align: center;
  font-size: 24rpx;
  color: #b8bfcc;
  padding: 20rpx 0;
}

/* 上报悬浮按钮 */
.report-fab {
  position: fixed;
  right: 40rpx;
  bottom: 200rpx;
  z-index: 40;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ffb8d1, #ff9fb2);
  color: #ffffff;
  font-size: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(255, 159, 178, 0.5);
}

.report-fab.hover {
  opacity: 0.85;
  transform: scale(0.94);
}
/* ---------- 开始寻找 loading 状态 ---------- */
.start-btn.loading {
  opacity: 0.7;
  pointer-events: none;
  animation: btnPulse 1s ease-in-out infinite;
}

@keyframes btnPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(0.96); }
}

/* ---------- 剩余次数颜色（≤5 橙 / 0 红） ---------- */
.quota-text.normal {
  color: #ff9fb2;
}

.quota-text.warn {
  color: #ffa94d;
}

.quota-text.zero {
  color: #e05a6d;
  font-weight: 700;
}

/* ---------- 筛选重置 ---------- */
.filter-reset {
  color: #e05a6d;
  border-color: rgba(224, 90, 109, 0.4);
  background: rgba(255, 159, 178, 0.12);
}

/* ---------- 地图定位按钮 ---------- */
.locate-fab {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  z-index: 30;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.94);
  border: 2rpx solid rgba(116, 185, 255, 0.4);
  color: #74b9ff;
  font-size: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(116, 185, 255, 0.3);
}

.locate-fab.hover {
  opacity: 0.8;
  transform: scale(0.94);
}

/* ---------- marker 简易气泡卡片 ---------- */
.bubble-card {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 120rpx;
  z-index: 35;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 16rpx 40rpx rgba(116, 185, 255, 0.3);
}

.bubble-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bubble-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #2c3e50;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.bubble-close {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(116, 185, 255, 0.15);
  color: #74b9ff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bubble-close.hover {
  opacity: 0.8;
}

.bubble-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.bubble-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #7f8c8d;
}

.bubble-actions {
  display: flex;
  margin-top: 20rpx;
}

.bubble-btn {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #74b9ff;
  background: #f0f7ff;
  border-radius: 44rpx;
  padding: 14rpx 0;
  margin-right: 16rpx;
}

.bubble-btn:last-child {
  margin-right: 0;
}

.bubble-btn.hover {
  opacity: 0.85;
}

.bubble-primary {
  background: linear-gradient(135deg, #74b9ff, #a8e6cf);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 8rpx 18rpx rgba(116, 185, 255, 0.32);
}

/* ---------- 展开按钮置灰 ---------- */
.expand-btn.disabled {
  color: #b8bfcc;
  background: #f2f4f8;
  pointer-events: none;
}

/* ---------- 筛选无匹配提示 ---------- */
.filter-empty-tip {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 169, 77, 0.14);
  color: #ffa94d;
  font-size: 24rpx;
  text-align: center;
}

/* ---------- 0 结果空状态弹窗 ---------- */
.empty-modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 80;
  background: rgba(44, 62, 80, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-modal {
  width: 600rpx;
  background: #ffffff;
  border-radius: 36rpx;
  padding: 48rpx 40rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(116, 185, 255, 0.35);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-modal-icon {
  font-size: 120rpx;
}

.empty-modal-title {
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #2c3e50;
}

.empty-modal-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #7f8c8d;
  text-align: center;
}

.empty-modal-actions {
  display: flex;
  width: 100%;
  margin-top: 40rpx;
}

.empty-modal-btn {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #74b9ff;
  background: #f0f7ff;
  border-radius: 50rpx;
  padding: 18rpx 0;
  margin-right: 20rpx;
}

.empty-modal-btn:last-child {
  margin-right: 0;
}

.empty-modal-btn.hover {
  opacity: 0.85;
  transform: scale(0.97);
}

.empty-primary {
  background: linear-gradient(135deg, #74b9ff, #a8e6cf);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(116, 185, 255, 0.35);
}