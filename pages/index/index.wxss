/* pages/index/index.wxss - 首页地图页样式（可爱马卡龙风） */
.page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #f7faff;
}

/* 地图大圆角容器：柔和浅蓝阴影，溢出裁剪 */
.map-wrap {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  border-radius: 48rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 36rpx rgba(116, 185, 255, 0.3);
}

.map {
  width: 100%;
  height: 100%;
  border-radius: 48rpx;
}

/* 列表视图切换按钮 */
.switch-btn {
  position: absolute;
  top: 52rpx;
  left: 44rpx;
  z-index: 10;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  color: #74b9ff;
  font-size: 26rpx;
  padding: 14rpx 28rpx;
  border-radius: 40rpx;
  box-shadow: 0 6rpx 18rpx rgba(116, 185, 255, 0.28);
}

.switch-icon {
  margin-right: 8rpx;
  font-size: 30rpx;
}

/* 回到定位按钮 */
.locate-btn {
  position: absolute;
  right: 48rpx;
  bottom: 340rpx;
  z-index: 10;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #FFFFFF;
  color: #74b9ff;
  font-size: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 18rpx rgba(116, 185, 255, 0.3);
}

.locate-btn.hover {
  opacity: 0.7;
}

/* 右下角悬浮加号：随时上报新公厕 */
.fab-add {
  position: absolute;
  right: 44rpx;
  bottom: 224rpx;
  z-index: 15;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #74b9ff, #a8e6cf);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 26rpx rgba(116, 185, 255, 0.5);
}

.fab-plus {
  font-size: 60rpx;
  line-height: 1;
  margin-top: -4rpx;
}

.fab-hover {
  opacity: 0.85;
  transform: scale(0.95);
}

/* 加载结果提示 */
.data-tip {
  position: absolute;
  left: 50%;
  bottom: 340rpx;
  transform: translateX(-50%);
  z-index: 12;
  max-width: 560rpx;
  font-size: 24rpx;
  color: #74b9ff;
  background: rgba(255, 255, 255, 0.94);
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 14rpx rgba(116, 185, 255, 0.2);
}

.data-tip-warn {
  color: #e8833a;
  background: rgba(255, 243, 224, 0.95);
}

/* 底部公厕简要卡片：大圆角 + 柔和浅蓝阴影 */
.toilet-card {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 40rpx;
  z-index: 20;
  border-radius: 32rpx;
  box-shadow: 0 12rpx 36rpx rgba(116, 185, 255, 0.32);
  padding: 28rpx;
  background: #ffffff;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c3e50;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-rating {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.rating-num {
  font-size: 24rpx;
  color: #ffb400;
  margin-left: 8rpx;
}

.card-dist {
  font-size: 24rpx;
  color: #7f8c8d;
  margin-left: 16rpx;
}

.card-tags {
  margin-top: 16rpx;
}

.card-actions {
  display: flex;
  margin-top: 24rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #74b9ff;
  border: 2rpx solid #74b9ff;
  border-radius: 40rpx;
  padding: 16rpx 0;
  margin-right: 20rpx;
  background: #ffffff;
}

.action-btn:last-child {
  margin-right: 0;
}

.action-primary {
  background: linear-gradient(135deg, #74b9ff, #a8e6cf);
  color: #FFFFFF;
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(116, 185, 255, 0.35);
}

/* 引导遮罩层 */
.locate-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 30;
  background: rgba(247, 250, 255, 0.94);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.mask-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 16rpx;
}

.mask-desc {
  font-size: 26rpx;
  color: #7f8c8d;
  margin-bottom: 48rpx;
  padding: 0 60rpx;
  text-align: center;
}

.mask-btn {
  width: 360rpx;
}

.mask-btn-plain {
  background: #FFFFFF;
  color: #74b9ff;
  border: 2rpx solid #74b9ff;
  margin-top: 20rpx;
  box-shadow: none;
}

.mask-link {
  margin-top: 28rpx;
  font-size: 26rpx;
  color: #74b9ff;
  text-decoration: underline;
}