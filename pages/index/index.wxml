<!-- pages/index/index.wxml - 首页：品牌区 + 地图卡片 + 快捷操作 + 悬浮底部菜单 -->
<view class="page">
  <!-- 顶部品牌区：Logo + 欢迎语 -->
  <view class="header">
    <image class="logo" src="/images/logo-toilet.png" mode="aspectFit" />
    <view class="welcome">
      <view class="welcome-title">急需方便？</view>
      <view class="welcome-sub">附近公厕，一键直达</view>
    </view>
  </view>

  <!-- 精准筛选栏：母婴室 / 无障碍 + 蹲位余量提示 -->
  <view class="filter-bar">
    <view class="filter-chip {{!filters.accessible && !filters.babyCare ? 'active' : ''}}" bindtap="clearFilter">全部</view>
    <view class="filter-chip {{filters.babyCare ? 'active' : ''}}" data-key="babyCare" bindtap="toggleFilter">🍼 母婴室</view>
    <view class="filter-chip {{filters.accessible ? 'active' : ''}}" data-key="accessible" bindtap="toggleFilter">♿ 无障碍</view>
    <view class="seat-chip">{{seatTip}}</view>
  </view>

  <!-- 核心功能区：地图卡片 -->
  <view class="map-card">
    <!-- 地图工具按钮（卡片右上角）：列表视图 / 回到定位 -->
    <view class="map-tools">
      <view class="tool-btn" bindtap="goList" hover-class="hover">☰</view>
      <view class="tool-btn" bindtap="locateMe" hover-class="hover">⌖</view>
    </view>

    <!-- 地图（大圆角容器，overflow 裁剪边角）
         公厕标记使用可爱马桶卡通图标：images/marker/toilet.png（选中态 images/marker/toilet-active.png）
         JS 中仍引用 /images/marker.png 与 /images/marker-active.png，两处内容保持一致 -->
    <view class="map-wrap">
      <map
        class="map"
        latitude="{{latitude}}"
        longitude="{{longitude}}"
        scale="{{scale}}"
        markers="{{markers}}"
        show-location="{{hasLocation}}"
        bindmarkertap="onMarkerTap"
        bindtap="onMapTap"
      ></map>
    </view>

    <!-- 加载结果提示 -->
    <view class="data-tip" wx:if="{{loadDone && toilets.length}}">已标注 {{markers.length}} 个公厕</view>
    <view class="data-tip data-tip-warn" wx:if="{{loadDone && !toilets.length && !initError}}" bindtap="retryLoad">暂未加载到公厕数据，点此重试（请先运行 initData）</view>

    <!-- 一键导航大按钮 -->
    <view class="nav-now-btn" hover-class="hover" bindtap="navNow">🧭 一键导航</view>
  </view>

  <!-- 快捷操作区：上报 / 评价记录 -->
  <view class="quick-actions">
    <view class="quick-item" bindtap="goReport" hover-class="hover">
      <view class="quick-circle quick-green">✚</view>
      <view class="quick-label">我要上报</view>
    </view>
    <view class="quick-item" bindtap="goList" hover-class="hover">
      <view class="quick-circle quick-orange">★</view>
      <view class="quick-label">评价/记录</view>
    </view>
    <view class="quick-item" bindtap="buyPaper" hover-class="hover">
      <view class="quick-circle quick-mint">🧻</view>
      <view class="quick-label">买纸</view>
    </view>
  </view>

  <!-- IP 形象：正在洗手的小水滴 -->
  <image class="mascot" src="/images/mascot-drop.png" mode="aspectFit" />

  <!-- 底部：厕所简要卡片（点击地图标记弹出） -->
  <view class="toilet-card card cute-card" wx:if="{{selectedToilet}}" catchtap="noop">
    <view class="card-head">
      <view class="card-name">{{selectedToilet.name}}</view>
      <view class="card-rating">
        <star-rating value="{{selectedToilet.rating}}" size="26" disabled="{{true}}" />
        <text class="rating-num">{{selectedToilet.rating ? selectedToilet.rating : '暂无评分'}}</text>
        <text class="card-dist" wx:if="{{selectedToilet.distanceText}}">{{selectedToilet.distanceText}}</text>
      </view>
    </view>
    <view class="card-tags" wx:if="{{selectedToilet.tags.length}}">
      <text class="tag" wx:for="{{selectedToilet.tags}}" wx:key="*this">{{item}}</text>
    </view>
    <view class="card-actions">
      <view class="action-btn" bindtap="goDetail">查看详情</view>
      <view class="action-btn action-primary" bindtap="navToToilet">导航</view>
    </view>
  </view>

  <!-- 悬浮式底部菜单：找厕所 / 上报 / 我的 -->
  <view class="tab-dock">
    <view class="dock-item dock-active" bindtap="dockHome">
      <view class="dock-icon-wrap">
        <image class="dock-icon" src="/images/tab-home-active.png" />
      </view>
      <view class="dock-label">找厕所</view>
    </view>
    <view class="dock-item" bindtap="goReport">
      <view class="dock-icon-wrap">
        <image class="dock-icon" src="/images/tab-report.png" />
      </view>
      <view class="dock-label">上报</view>
    </view>
    <view class="dock-item" bindtap="goProfile">
      <view class="dock-icon-wrap">
        <image class="dock-icon" src="/images/tab-profile.png" />
      </view>
      <view class="dock-label">我的</view>
    </view>
  </view>

  <!-- 数据库未初始化引导层 -->
  <view class="locate-mask" wx:if="{{initError}}">
    <view class="mask-title">云数据库尚未初始化</view>
    <view class="mask-desc">首次使用需先部署并运行 initData 云函数，会自动创建集合并导入演示公厕。</view>
    <view class="mask-btn btn-primary" bindtap="retryLoad">重新加载</view>
    <view class="mask-link" bindtap="noop">详见 README「部署步骤」</view>
  </view>

  <!-- 定位失败引导层 -->
  <view class="locate-mask" wx:if="{{loadingDone && !locationReady && !locateMaskHidden}}">
    <view class="mask-title">获取位置失败</view>
    <view class="mask-desc">开启定位后，才能展示你附近的公共厕所</view>
    <view class="mask-btn btn-primary" bindtap="retryLocation">重新定位</view>
    <view class="mask-btn mask-btn-plain" bindtap="skipLocateMask">先浏览地图</view>
    <view class="mask-link" bindtap="openSetting">去设置开启定位权限</view>
  </view>
</view>