<!-- pages/index/index.wxml - 附近厕所主页面：半径选择 + 开始寻找 + 红色查询圈 + 圈内 marker + 底部统计/列表 + 详情弹窗 -->
<view class="page">

  <!-- 顶部：标题 + 半径下拉 + 开始寻找 -->
  <view class="top-bar">
    <view class="page-title">附近厕所</view>
    <view class="radius-row">
      <picker class="radius-picker" mode="selector" range="{{radiusOptions}}" value="{{radiusIndex}}" bindchange="onRadiusChange">
        <view class="radius-select">半径: {{selectedRadius}}米 ▾</view>
      </picker>
      <text class="radius-text">查询范围:{{selectedRadius}}米</text>
      <view class="start-btn {{loading ? 'disabled' : ''}}" hover-class="hover" bindtap="startSearch">开始寻找</view>
    </view>
    <view class="quota-text">今日剩余查询次数：{{remaining}} /{{dailyLimit}}</view>
  </view>

  <!-- 定位失败提示条（可关闭，不遮挡地图） -->
  <view class="locate-banner" wx:if="{{loadingDone && !locationReady && !locateTipHidden}}">
    <view class="banner-head">
      <text class="banner-text">📍 定位失败，已切换到默认位置</text>
      <view class="banner-close" hover-class="hover" bindtap="closeLocateTip">✕</view>
    </view>
    <view class="banner-actions">
      <view class="banner-btn" hover-class="hover" bindtap="retryLocation">重新定位</view>
    </view>
  </view>

  <!-- 顶部筛选栏（仅对已获取圈内数据生效，不消耗查询次数） -->
  <view class="filter-bar">
    <view class="filter-chip {{filters.hasPaper ? 'active' : ''}}" data-key="hasPaper" bindtap="toggleFilter">🧻 有纸</view>
    <view class="filter-chip {{filters.barrierFree ? 'active' : ''}}" data-key="barrierFree" bindtap="toggleFilter">♿ 无障碍</view>
    <view class="filter-chip {{filters.babyRoom ? 'active' : ''}}" data-key="babyRoom" bindtap="toggleFilter">🍼 母婴室</view>
    <view class="filter-chip {{filters.open24h ? 'active' : ''}}" data-key="open24h" bindtap="toggleFilter">🌙 24小时</view>
  </view>

  <!-- 地图卡片 -->
  <view class="map-card">
    <map
      class="map"
      latitude="{{latitude}}"
      longitude="{{longitude}}"
      scale="15"
      markers="{{markers}}"
      circles="{{circles}}"
      show-location="{{locationReady}}"
      bindmarkertap="onMarkerTap"
    ></map>

    <!-- 未查询提示 -->
    <view class="map-tip" wx:if="{{!searched}}">请选择范围并点击开始寻找</view>
    <!-- 加载中 -->
    <view class="map-tip" wx:if="{{loading}}">正在寻找附近的厕所…</view>
    <!-- 查询结果为空 -->
    <view class="map-tip map-tip-warn" wx:if="{{searched && !loading && !totalCount}}">附近暂未找到公厕，试试扩大半径或上报新点位</view>
  </view>

  <!-- 底部卡片：统计 + 展开 -->
  <view class="bottom-card cute-card" wx:if="{{searched}}">
    <view class="bottom-head">
      <text class="bottom-count">在您附近找到 {{totalCount}} 个厕所</text>
      <view class="expand-btn" hover-class="hover" bindtap="toggleList">{{showList ? '收起 ▴' : '展开 ▾'}}</view>
    </view>

    <!-- 展开列表：按距离由近到远排序 -->
    <scroll-view class="toilet-list" scroll-y wx:if="{{showList}}">
      <view class="list-item" wx:for="{{toilets}}" wx:key="index" data-index="{{index}}" bindtap="onListItemTap" hover-class="hover">
        <view class="item-main">
          <view class="item-name">{{item.name}}</view>
          <view class="item-tags">
            <text class="tag" wx:if="{{item.source === 'gov'}}">政府导入</text>
            <text class="tag" wx:elif="{{item.source === 'user'}}">用户上报</text>
            <text class="tag" wx:elif="{{item.source === 'tencent'}}">腾讯POI</text>
            <text class="tag" wx:if="{{item.hasPaper}}">有纸</text>
            <text class="tag" wx:if="{{item.isBarrierFree}}">无障碍</text>
            <text class="tag" wx:if="{{item.hasBabyRoom}}">母婴室</text>
          </view>
          <view class="item-meta">⭐ {{item.rating || '暂无'}} · {{item.ratingCount || 0}}人评</view>
        </view>
        <view class="item-dist">{{item.distanceText || item.distance + 'm'}}</view>
      </view>
    </scroll-view>
  </view>

  <!-- 空状态（未查询/无数据） -->
  <view class="empty-state" wx:if="{{!searched}}">
    <text class="empty-icon">🚻</text>
    <text class="empty-text">选择查询范围，点击「开始寻找」查看附近公厕</text>
  </view>

  <!-- 详情弹窗 -->
  <view class="detail-mask" wx:if="{{selectedToilet}}" catchtap="closeDetail">
    <view class="detail-card" catchtap="noop">
      <view class="detail-head">
        <view class="detail-name">{{selectedToilet.name}}</view>
        <view class="detail-close" hover-class="hover" bindtap="closeDetail">✕</view>
      </view>
      <view class="detail-tags">
        <text class="tag tag-source" wx:if="{{selectedToilet.source === 'gov'}}">政府导入</text>
        <text class="tag tag-source" wx:elif="{{selectedToilet.source === 'user'}}">用户上报</text>
        <text class="tag tag-source" wx:elif="{{selectedToilet.source === 'tencent'}}">腾讯POI</text>
        <text class="tag" wx:if="{{selectedToilet.hasPaper}}">🧻 有纸</text>
        <text class="tag" wx:if="{{selectedToilet.isBarrierFree}}">♿ 无障碍</text>
        <text class="tag" wx:if="{{selectedToilet.hasBabyRoom}}">🍼 母婴室</text>
        <text class="tag" wx:if="{{selectedToilet.isCharge}}">💰 收费</text>
      </view>
      <view class="detail-rating">⭐ {{selectedToilet.rating || '暂无评分'}} · {{selectedToilet.ratingCount || 0}}条评价 · 距您{{selectedToilet.distanceText}}</view>

      <view class="detail-actions">
        <view class="detail-btn detail-primary" hover-class="hover" bindtap="navToToilet">🧭 导航</view>
        <view class="detail-btn" hover-class="hover" bindtap="toggleFavorite">{{favorited ? '❤️ 已收藏' : '🤍 收藏'}}</view>
        <view class="detail-btn" hover-class="hover" bindtap="reportToilet">⚠️ 举报</view>
      </view>

      <!-- 写评价 -->
      <view class="comment-form" wx:if="{{selectedToilet._id}}">
        <view class="star-row">
          <text class="star" wx:for="{{[1,2,3,4,5]}}" wx:key="*this" data-score="{{item}}" bindtap="onScoreTap">{{item <= commentScore ? '⭐' : '☆'}}</text>
        </view>
        <textarea class="comment-input" placeholder="写下您的评价…" value="{{commentContent}}" bindinput="onCommentInput" maxlength="200"></textarea>
        <view class="submit-comment-btn {{submittingComment ? 'disabled' : ''}}" hover-class="hover" bindtap="submitComment">提交评价</view>
      </view>

      <!-- 历史评价 -->
      <view class="comment-list">
        <view class="comment-item" wx:for="{{comments}}" wx:key="_id">
          <view class="comment-head">
            <text class="comment-user">{{item.nickname || '微信用户'}}</text>
            <text class="comment-score">⭐ {{item.score}}</text>
          </view>
          <view class="comment-content">{{item.content}}</view>
        </view>
        <view class="comment-empty" wx:if="{{!comments.length}}">暂无评价，快来抢沙发～</view>
      </view>
    </view>
  </view>

  <!-- 上报入口（悬浮） -->
  <view class="report-fab" hover-class="hover" bindtap="goReport">➕</view>
</view>