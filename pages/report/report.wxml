<!-- pages/report/report.wxml - 上报公厕页 -->
<view class="page">
  <!-- 返回主页 -->
  <view class="back-home" bindtap="goHome" hover-class="hover">
    <text class="back-home-icon">🏠</text>
    <text>返回主页</text>
  </view>

  <view class="card cute-card">
    <!-- 厕所名称 -->
    <view class="field">
      <view class="field-label">厕所名称 <text class="required">*</text></view>
      <input
        class="field-input"
        placeholder="例如：天河公园东门公厕"
        placeholder-class="ph"
        value="{{name}}"
        bindinput="onNameInput"
        maxlength="30"
      />
    </view>

    <!-- 位置选择 -->
    <view class="field">
      <view class="field-label">位置 <text class="required">*</text></view>
      <view class="locate-btn btn-outline" hover-class="hover" bindtap="chooseLocation">📍 在地图上选择位置</view>
      <view class="locate-result" wx:if="{{location}}">已选择：{{location.address}}</view>
      <input
        class="field-input"
        placeholder="补充详细地址（必填）"
        placeholder-class="ph"
        value="{{address}}"
        bindinput="onAddressInput"
        maxlength="60"
      />
    </view>

    <!-- 开放时间 -->
    <view class="field">
      <view class="field-label">开放时间</view>
      <input
        class="field-input"
        placeholder="例如：06:00-22:00，留空默认全天开放"
        placeholder-class="ph"
        value="{{openTime}}"
        bindinput="onOpenTimeInput"
        maxlength="30"
      />
    </view>

    <!-- 设施标签 -->
    <view class="field">
      <view class="field-label">设施标签（多选）</view>
      <view class="tag-picker">
        <view
          class="tag-option {{tags.isBarrierFree ? 'active' : ''}}"
          data-key="isBarrierFree"
          bindtap="toggleTag" hover-class="hover"
        >♿ 无障碍</view>
        <view
          class="tag-option {{tags.hasBabyRoom ? 'active' : ''}}"
          data-key="hasBabyRoom"
          bindtap="toggleTag" hover-class="hover"
        >🍼 母婴室</view>
        <view
          class="tag-option {{tags.hasPaper ? 'active' : ''}}"
          data-key="hasPaper"
          bindtap="toggleTag" hover-class="hover"
        >🧻 有纸巾</view>
        <view
          class="tag-option {{tags.isOpen24h ? 'active' : ''}}"
          data-key="isOpen24h"
          bindtap="toggleTag" hover-class="hover"
        >🌙 24小时开放</view>
      </view>
    </view>

    <!-- 收费情况单选 -->
    <view class="field">
      <view class="field-label">收费情况</view>
      <view class="tag-picker">
        <view
          class="tag-option fee-option {{feeType === 'free' ? 'active' : ''}}"
          data-fee="free"
          bindtap="selectFee" hover-class="hover"
        >💰 免费</view>
        <view
          class="tag-option fee-option {{feeType === 'paid' ? 'active' : ''}}"
          data-fee="paid"
          bindtap="selectFee" hover-class="hover"
        >💴 收费</view>
        <view
          class="tag-option fee-option {{feeType === 'other' ? 'active' : ''}}"
          data-fee="other"
          bindtap="selectFee" hover-class="hover"
        >🤔 其他</view>
      </view>
      <input
        class="field-input fee-input"
        wx:if="{{feeType === 'other'}}"
        placeholder="例如：扫码付费、捐款箱等"
        placeholder-class="ph"
        value="{{feeDesc}}"
        bindinput="onFeeDescInput"
        maxlength="30"
      />
    </view>

    <!-- 现场照片 -->
    <view class="field">
      <view class="field-label">现场照片（最多 3 张）</view>
      <view class="photo-picker">
        <view class="photo-item" wx:for="{{photos}}" wx:key="*this">
          <image src="{{item}}" mode="aspectFill" class="photo-img" />
          <view class="photo-del" hover-class="hover" data-index="{{index}}" bindtap="removePhoto">×</view>
        </view>
        <view class="photo-add" hover-class="hover" wx:if="{{photos.length < 3}}" bindtap="choosePhotos">＋</view>
      </view>
    </view>

    <!-- 提交 -->
    <view class="submit-btn btn-primary {{submitting ? 'btn-disabled' : ''}}" hover-class="hover" bindtap="submit">
      {{submitting ? '提交中...' : '提交上报'}}
    </view>
  </view>

  <view class="tips">提交后将进入审核，审核通过即可在地图展示（上报不消耗查询次数）</view>
</view>