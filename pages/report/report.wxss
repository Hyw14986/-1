/* pages/report/report.wxss - 上报公厕页样式（可爱马卡龙风） */
.page {
  padding: 0 0 40rpx;
}

/* 表单整体卡片：可爱大圆角 + 柔和浅蓝阴影 */
.card {
  border-radius: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(116, 185, 255, 0.16);
}

.field {
  margin-bottom: 32rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.field-label {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.required {
  color: #ff8fb1;
  font-weight: 700;
  font-size: 32rpx;
}

.field-input {
  width: 100%;
  height: 84rpx;
  background: #f0f7ff;
  border-radius: 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #2c3e50;
}

.locate-btn {
  height: 84rpx;
  line-height: 84rpx;
  padding: 0;
  margin-bottom: 16rpx;
}

.locate-result {
  font-size: 24rpx;
  color: #74b9ff;
  background: rgba(116, 185, 255, 0.12);
  border-radius: 20rpx;
  padding: 14rpx 20rpx;
  margin-bottom: 16rpx;
  word-break: break-all;
}

/* 标签多选 */
.tag-picker {
  display: flex;
  flex-wrap: wrap;
}

.tag-option {
  font-size: 26rpx;
  color: #7f8c8d;
  background: #f4f6f9;
  border: 2rpx solid #e8ecf1;
  border-radius: 40rpx;
  padding: 14rpx 32rpx;
  margin: 0 16rpx 16rpx 0;
}

.tag-option.active {
  color: #74b9ff;
  font-weight: 600;
  background: rgba(116, 185, 255, 0.16);
  border-color: #74b9ff;
}

/* 照片选择 */
.photo-picker {
  display: flex;
  flex-wrap: wrap;
}

.photo-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  margin: 0 16rpx 16rpx 0;
}

.photo-img {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 16rpx rgba(116, 185, 255, 0.18);
}

.photo-del {
  position: absolute;
  top: -16rpx;
  right: -16rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(44, 62, 80, 0.65);
  color: #FFFFFF;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-add {
  width: 180rpx;
  height: 180rpx;
  border: 2rpx dashed #b9cde8;
  border-radius: 24rpx;
  color: #b9cde8;
  background: #f7fbff;
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 提交按钮（药丸圆角） */
.submit-btn {
  margin: 40rpx 0 24rpx;
  border-radius: 50rpx;
}

.tips {
  text-align: center;
  font-size: 22rpx;
  color: #7f8c8d;
  margin: 0 24rpx 32rpx;
}