/* pages/report/report.wxss - 上报页「苹果白」简约版（业务绑定零改动，无渐变） */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 0 60rpx;
  background: #f5f5f7;
}

/* 返回主页 */
.back-home {
  display: inline-flex;
  align-items: center;
  margin: 24rpx 28rpx 0;
  padding: 12rpx 32rpx;
  background: #ffffff;
  border-radius: 44rpx;
  color: #007aff;
  font-size: 26rpx;
  font-weight: 600;
  border: 1rpx solid #efeff4;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.back-home-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
}

/* 寄语横幅 */
.report-banner {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 24rpx 28rpx 0;
  background: #ffffff;
  border: 1rpx solid #efeff4;
  border-radius: 28rpx;
  padding: 26rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.report-banner-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 14rpx;
}

.report-banner-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #1d1d1f;
  letter-spacing: 1rpx;
}

.rbubble {
  position: absolute;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(0, 122, 255, 0.08);
  animation: floatY 3.2s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  pointer-events: none;
}

.rbubble.r1 { top: 12rpx; right: 130rpx; }
.rbubble.r2 { bottom: 12rpx; right: 30rpx; width: 26rpx; height: 26rpx; animation-delay: 0.6s; }

@keyframes floatY {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

/* 表单分组卡片 */
.form-group {
  border-radius: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  margin-top: 26rpx;
}

.form-group .section-title {
  margin-bottom: 30rpx;
}

.section-ico {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

/* 表单字段 */
.field {
  margin-bottom: 34rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.field-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1d1d1f;
  margin-bottom: 16rpx;
}

.required {
  color: #ff3b30;
  margin-left: 4rpx;
}

.field-input {
  width: 100%;
  height: 84rpx;
  background: #f2f2f7;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1d1d1f;
  box-sizing: border-box;
}

/* 地图选点按钮：药丸 */
.locate-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  background: #f2f2f7;
  border-radius: 50rpx;
  color: #007aff;
  font-size: 28rpx;
  font-weight: 600;
  border: 1rpx solid transparent;
}

.locate-btn-ico {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
}

.locate-result {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6e6e73;
  line-height: 1.5;
}

/* 标签选择 */
.tag-picker {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-option {
  display: flex;
  align-items: center;
  padding: 16rpx 26rpx;
  border-radius: 40rpx;
  background: #f2f2f7;
  color: #3a3a3c;
  font-size: 26rpx;
  font-weight: 600;
  border: 2rpx solid transparent;
  transition: background 0.22s cubic-bezier(0.22, 1, 0.36, 1), color 0.22s ease-out, border-color 0.22s ease-out, transform 0.18s cubic-bezier(0.22, 1, 0.36, 1);
}

.tag-ico {
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
}

.tag-option.active {
  background: #ffffff;
  color: #007aff;
  border-color: #007aff;
  box-shadow: 0 4rpx 14rpx rgba(0, 122, 255, 0.18);
}

/* 体验评分 */
.score-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f2f2f7;
}

.score-row:last-of-type {
  border-bottom: none;
}

.score-name {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #3a3a3c;
}

.score-ico {
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
}

.star-picker {
  display: flex;
  align-items: center;
}

.star {
  width: 44rpx;
  height: 44rpx;
  margin-left: 8rpx;
  transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1);
}

.total-score-row {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.total-score-label {
  font-size: 24rpx;
  color: #6e6e73;
  margin-right: 12rpx;
}

.total-score-num {
  font-size: 48rpx;
  font-weight: 800;
  color: #007aff;
}

.total-score-unit {
  font-size: 26rpx;
  color: #6e6e73;
  margin-left: 6rpx;
}

/* 现场照片（单张） */
.photo-picker {
  display: flex;
  flex-wrap: wrap;
}

.photo-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #f2f2f7;
  border: 1rpx solid #efeff4;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-del {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-del-ico {
  width: 24rpx;
  height: 24rpx;
}

.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 200rpx;
  border-radius: 24rpx;
  background: #f2f2f7;
  color: #007aff;
  font-size: 24rpx;
  font-weight: 600;
  border: 2rpx dashed #c7c7cc;
}

.photo-add-ico {
  width: 52rpx;
  height: 52rpx;
  margin-bottom: 8rpx;
}

/* 留言输入 */
.note-input {
  width: 100%;
  height: 160rpx;
  background: #f2f2f7;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #1d1d1f;
  box-sizing: border-box;
}

/* 提交按钮 */
.submit-btn {
  margin: 40rpx 28rpx 0;
  transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.2s ease-out;
}

.tips {
  margin: 20rpx 28rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: #aeaeb2;
}

.seat-option.active,
.fee-option.active {
  background: #ffffff;
  color: #007aff;
  border-color: #007aff;
}

.fee-input {
  margin-top: 16rpx;
}