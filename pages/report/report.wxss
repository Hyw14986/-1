/* pages/report/report.wxss - 上报公厕页样式（温馨可爱扁平插画风，与首页同款） */
.page {
  padding: 0 0 40rpx;
}

/* 返回主页按钮 */
.back-home {
  display: inline-flex;
  align-items: center;
  margin: 16rpx 24rpx 0;
  padding: 12rpx 30rpx;
  background: #ffffff;
  border-radius: 40rpx;
  color: #ffa94d;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(255, 169, 77, 0.2);
}

.back-home-icon {
  margin-right: 8rpx;
  font-size: 28rpx;
}

.back-home.hover {
  opacity: 0.8;
}

/* 表单整体卡片：可爱大圆角 + 柔和暖橙阴影 */
.card {
  border-radius: 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(255, 169, 77, 0.18);
}

.field {
  margin-bottom: 32rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.field-label {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.required {
  color: #ff8fb1;
  font-weight: 700;
  font-size: 32rpx;
}

.field-input {
  width: 100%;
  height: 84rpx;
  background: #fff4e0;
  border-radius: 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #2c3e50;
}

.locate-btn {
  height: 84rpx;
  line-height: 84rpx;
  padding: 0;
  margin-bottom: 16rpx;
}

.locate-result {
  font-size: 24rpx;
  color: #e8833a;
  background: rgba(255, 169, 77, 0.12);
  border-radius: 20rpx;
  padding: 14rpx 20rpx;
  margin-bottom: 16rpx;
  word-break: break-all;
}

/* 标签多选 */
.tag-picker {
  display: flex;
  flex-wrap: wrap;
}

.tag-option {
  font-size: 26rpx;
  color: #7f8c8d;
  background: #fdf3e3;
  border: 2rpx solid #f2e0c4;
  border-radius: 40rpx;
  padding: 14rpx 32rpx;
  margin: 0 16rpx 16rpx 0;
}

.tag-option.active {
  color: #e8833a;
  font-weight: 600;
  background: rgba(255, 169, 77, 0.18);
  border-color: #ffa94d;
}

/* 照片选择 */
.photo-picker {
  display: flex;
  flex-wrap: wrap;
}

.photo-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  margin: 0 16rpx 16rpx 0;
}

.photo-img {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 16rpx rgba(255, 169, 77, 0.2);
}

.photo-del {
  position: absolute;
  top: -16rpx;
  right: -16rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(44, 62, 80, 0.65);
  color: #FFFFFF;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-add {
  width: 180rpx;
  height: 180rpx;
  border: 2rpx dashed #ffcf9e;
  border-radius: 24rpx;
  color: #ffa94d;
  background: #fff7e8;
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 提交按钮（药丸圆角） */
.submit-btn {
  margin: 40rpx 0 24rpx;
  border-radius: 50rpx;
}

.tips {
  text-align: center;
  font-size: 22rpx;
  color: #7f8c8d;
  margin: 0 24rpx 32rpx;
}