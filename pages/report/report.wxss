/* pages/report/report.wxss - 上报公厕页样式 */
.page {
  padding: 24rpx 24rpx 60rpx;
}

.field {
  margin-bottom: 32rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.field-label {
  font-size: 28rpx;
  color: #333333;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.required {
  color: #FF5252;
}

.field-input {
  width: 100%;
  height: 84rpx;
  background: #F7FAFC;
  border-radius: 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.locate-btn {
  height: 84rpx;
  line-height: 84rpx;
  padding: 0;
  margin-bottom: 16rpx;
}

.locate-result {
  font-size: 24rpx;
  color: #29B6F6;
  background: rgba(41, 182, 246, 0.08);
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  margin-bottom: 16rpx;
  word-break: break-all;
}

/* 标签多选 */
.tag-picker {
  display: flex;
  flex-wrap: wrap;
}

.tag-option {
  font-size: 26rpx;
  color: #666666;
  background: #F7FAFC;
  border: 2rpx solid #E0E6EC;
  border-radius: 36rpx;
  padding: 14rpx 30rpx;
  margin: 0 16rpx 16rpx 0;
}

.tag-option.active {
  color: #29B6F6;
  background: rgba(41, 182, 246, 0.1);
  border-color: #29B6F6;
}

/* 照片选择 */
.photo-picker {
  display: flex;
  flex-wrap: wrap;
}

.photo-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  margin: 0 16rpx 16rpx 0;
}

.photo-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.photo-del {
  position: absolute;
  top: -16rpx;
  right: -16rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #FFFFFF;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-add {
  width: 180rpx;
  height: 180rpx;
  border: 2rpx dashed #B9C4CE;
  border-radius: 12rpx;
  color: #B9C4CE;
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 提交按钮 */
.submit-btn {
  margin-top: 8rpx;
}

.tips {
  text-align: center;
  font-size: 22rpx;
  color: #B9C4CE;
  margin-top: 24rpx;
}
