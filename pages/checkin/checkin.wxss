/* pages/checkin/checkin.wxss - 厕所打卡，柔和浅蓝异形鼓包圆角 */
.checkin-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 34rpx 28rpx 80rpx;
  background: #eaf4ff;
  background-image: linear-gradient(180deg, #eaf4ff 0%, #f8fcff 100%);
  color: #1f2937;
}

.checkin-hero {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border: 1rpx solid #d9e9fb;
  border-radius: 56rpx 40rpx 60rpx 42rpx / 50rpx 60rpx 42rpx 56rpx;
  background: linear-gradient(135deg, #eef6ff 0%, #ffffff 60%);
  box-shadow: 0 14rpx 40rpx rgba(64, 150, 255, 0.09);
}

.hero-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  margin-right: 24rpx;
  border-radius: 34rpx 44rpx 38rpx 46rpx / 42rpx 34rpx 46rpx 38rpx;
  background: #e8f4ff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hero-icon {
  width: 52rpx;
  height: 52rpx;
}

.hero-body {
  flex: 1;
  min-width: 0;
}

.hero-title {
  font-size: 40rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #1f2937;
}

.hero-sub {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.4;
  color: #6b7f99;
}

.checkin-main-card {
  margin-top: 28rpx;
  padding: 34rpx 30rpx 30rpx;
  border: 1rpx solid #d9e9fb;
  border-radius: 58rpx 42rpx 62rpx 44rpx / 52rpx 62rpx 44rpx 58rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 46rpx rgba(64, 150, 255, 0.08);
}

.date-line {
  font-size: 26rpx;
  font-weight: 600;
  color: #4b6077;
}

.status-row {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.status-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  margin-right: 16rpx;
  border-radius: 24rpx 32rpx 26rpx 34rpx / 30rpx 24rpx 34rpx 26rpx;
  background: #e8f4ff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.status-icon {
  width: 34rpx;
  height: 34rpx;
}

.status-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.stats-row {
  display: flex;
  margin-top: 32rpx;
  gap: 20rpx;
}

.stat-item {
  flex: 1;
  padding: 24rpx 10rpx;
  border-radius: 40rpx 52rpx 44rpx 54rpx / 52rpx 40rpx 56rpx 44rpx;
  background: #f8fcff;
  border: 1rpx solid #eaf4ff;
  text-align: center;
}

.stat-num {
  font-size: 52rpx;
  font-weight: 700;
  color: #4096ff;
  line-height: 1;
}

.stat-label {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8aa5c4;
}

.checkin-btn {
  margin-top: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 26rpx 0;
  border-radius: 50rpx 64rpx 54rpx 62rpx / 62rpx 50rpx 66rpx 50rpx;
  background: #4096ff;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 14rpx 32rpx rgba(64, 150, 255, 0.24);
}

.checkin-btn.checked {
  background: #e8f4ff;
  color: #2f7ff0;
  box-shadow: 0 8rpx 22rpx rgba(64, 150, 255, 0.10);
}

.checkin-btn.hover {
  background: #2f7ff0;
}

.checkin-btn.checked.hover {
  background: #dceeff;
}

.checkin-btn-ico {
  width: 38rpx;
  height: 38rpx;
  margin-right: 12rpx;
  filter: brightness(0) invert(1);
}

.checkin-btn.checked .checkin-btn-ico {
  filter: none;
}

.history-card {
  margin-top: 28rpx;
  padding: 30rpx;
  border: 1rpx solid #d9e9fb;
  border-radius: 56rpx 40rpx 60rpx 42rpx / 50rpx 60rpx 42rpx 56rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 34rpx rgba(64, 150, 255, 0.07);
}

.history-head {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.history-ico {
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
}

.history-list {
  margin-top: 22rpx;
}

.history-item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  font-size: 24rpx;
  color: #4b6077;
}

.history-dot {
  width: 16rpx;
  height: 16rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #bcdcff;
}

.history-empty {
  padding: 24rpx 0 4rpx;
  font-size: 24rpx;
  color: #8aa5c4;
}

.back-home {
  display: inline-flex;
  align-items: center;
  margin-top: 28rpx;
  padding: 14rpx 28rpx;
  border-radius: 40rpx 54rpx 44rpx 56rpx / 52rpx 40rpx 58rpx 44rpx;
  background: #ffffff;
  border: 1rpx solid #d9e9fb;
  color: #4096ff;
  font-size: 23rpx;
  font-weight: 500;
}

.back-home.hover {
  background: #e8f4ff;
  border-color: #bcdcff;
}

.back-home-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
}