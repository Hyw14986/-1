/* pages/detail/detail.wxss - 厕所详情页「苹果白」简约版（业务绑定零改动，无渐变） */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 80rpx;
  background: #f5f5f7;
}

/* 顶部封面 */
.cover {
  position: relative;
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid #efeff4;
  border-radius: 32rpx;
  padding: 40rpx 32rpx 34rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.cover-emoji {
  width: 88rpx;
  height: 88rpx;
}

.name {
  margin-top: 12rpx;
  font-size: 44rpx;
  font-weight: 800;
  color: #1d1d1f;
  line-height: 1.3;
}

.rating-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.score {
  margin-left: 14rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #1d1d1f;
}

.count,
.dist {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #6e6e73;
}

.tags {
  margin-top: 18rpx;
}

.bubble {
  position: absolute;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0, 122, 255, 0.08);
  animation: floatY 3.4s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  pointer-events: none;
}

.bubble.d1 { top: 20rpx; right: 130rpx; }
.bubble.d2 { bottom: 24rpx; right: 36rpx; width: 28rpx; height: 28rpx; animation-delay: 0.7s; }

@keyframes floatY {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

/* 卡片 */
.card {
  margin-top: 24rpx;
}

.head-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 30rpx;
  border: 1rpx solid #efeff4;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.section-ico {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.info-grid {
  margin-top: 8rpx;
}

.info-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2f2f7;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #6e6e73;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.info-ico {
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
}

.info-value {
  font-size: 26rpx;
  color: #1d1d1f;
  font-weight: 600;
  text-align: right;
}

.nav-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
  transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.2s ease-out;
}

.btn-ico {
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
}

.photo-card,
.comment-card,
.form-card,
.my-comment-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 30rpx;
  border: 1rpx solid #efeff4;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.photo-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.photo {
  width: 200rpx;
  height: 200rpx;
  border-radius: 20rpx;
  margin: 0 16rpx 16rpx 0;
  background: #f2f2f7;
}

.comment-item {
  display: flex;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f2f2f7;
}

.comment-item:last-child {
  border-bottom: none;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 18rpx;
  flex-shrink: 0;
  background: #f2f2f7;
}

.comment-body {
  flex: 1;
  min-width: 0;
}

.comment-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nickname {
  font-size: 26rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.time {
  font-size: 22rpx;
  color: #aeaeb2;
}

.comment-content {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #3a3a3c;
  line-height: 1.6;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
  color: #aeaeb2;
  font-size: 26rpx;
}

.empty-icon {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 20rpx;
}

/* 评价表单 */
.form-rating {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.form-label {
  font-size: 28rpx;
  color: #3a3a3c;
  margin-right: 20rpx;
}

.form-score {
  margin-left: 20rpx;
  font-size: 24rpx;
  color: #6e6e73;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  background: #f2f2f7;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #1d1d1f;
  box-sizing: border-box;
}

.submit-btn {
  margin-top: 24rpx;
  transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.2s ease-out;
}

.my-comment-card .comment-content {
  margin-top: 16rpx;
}

.done-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #34c759;
}