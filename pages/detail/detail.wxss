/* pages/detail/detail.wxss - 厕所详情页样式（温馨可爱扁平插画风，与首页同款） */
.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

/* 基本信息卡 */
.head-card {
  border-radius: 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(255, 169, 77, 0.2);
}

.name {
  font-size: 38rpx;
  font-weight: 700;
  color: #2c3e50;
}

.rating-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.score {
  font-size: 30rpx;
  color: #ffb400;
  font-weight: 600;
  margin-left: 12rpx;
}

.count {
  font-size: 24rpx;
  color: #7f8c8d;
  margin-left: 16rpx;
}

.dist {
  font-size: 24rpx;
  color: #e8833a;
  background: rgba(255, 169, 77, 0.16);
  border-radius: 24rpx;
  padding: 4rpx 14rpx;
  margin-left: 20rpx;
}

.tags {
  margin-top: 20rpx;
}

.info-grid {
  margin-top: 24rpx;
  border-top: 2rpx solid #f7ead6;
  padding-top: 8rpx;
}

.info-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #fbf1de;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  width: 150rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #7f8c8d;
}

.info-value {
  flex: 1;
  font-size: 26rpx;
  color: #2c3e50;
}

.nav-btn {
  margin-top: 28rpx;
  border-radius: 50rpx;
}

/* 照片 */
.photo-card {
  margin-top: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 20rpx;
}

.photo-list {
  display: flex;
  flex-wrap: wrap;
}

.photo {
  width: 200rpx;
  height: 200rpx;
  border-radius: 20rpx;
  margin: 0 16rpx 16rpx 0;
  box-shadow: 0 6rpx 16rpx rgba(255, 169, 77, 0.2);
}

/* 评价列表 */
.comment-card,
.form-card,
.my-comment-card {
  margin-top: 24rpx;
}

.comment-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f7ead6;
}

.comment-item:last-child {
  border-bottom: none;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #fdf3e3;
  border: 4rpx solid #ffffff;
  box-shadow: 0 4rpx 10rpx rgba(255, 169, 77, 0.25);
  flex-shrink: 0;
}

.comment-body {
  flex: 1;
  margin-left: 20rpx;
}

.comment-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nickname {
  font-size: 26rpx;
  color: #2c3e50;
  font-weight: 600;
}

.time {
  font-size: 22rpx;
  color: #aab6c3;
}

.comment-content {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #5b6b79;
  line-height: 1.6;
}

/* 评价表单 */
.form-rating {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.form-label {
  font-size: 28rpx;
  color: #2c3e50;
  margin-right: 24rpx;
}

.form-score {
  font-size: 26rpx;
  color: #ffb400;
  margin-left: 20rpx;
}

.form-textarea {
  width: 100%;
  height: 180rpx;
  background: #fff4e0;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #2c3e50;
}

.submit-btn {
  margin-top: 24rpx;
  border-radius: 50rpx;
}

/* 已评价 */
.my-comment-card .comment-content {
  margin: 12rpx 0;
}

.done-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #7f8c8d;
}