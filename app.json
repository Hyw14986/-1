{
  "pages": [
    "pages/index/index",
    "pages/profile/profile",
    "pages/checkin/checkin",
    "pages/searchRecord/searchRecord",
    "pages/rank/rank"
  ],
  "window": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "找厕所不迷路",
    "navigationBarBackgroundColor": "#F4F8FF",
    "backgroundColor": "#F4F8FF"
  },
  "tabBar": {
    "custom": true,
    "color": "#8E8E93",
    "selectedColor": "#3478F6",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "找厕所",
        "iconPath": "images/tab-home.png",
        "selectedIconPath": "images/tab-home-active.png"
      },
      {
        "pagePath": "pages/profile/profile",
        "text": "我的",
        "iconPath": "images/tab-profile.png",
        "selectedIconPath": "images/tab-profile-active.png"
      }
    ]
  },
  "permission": {
    "scope.userLocation": {
      "desc": "你的位置信息将用于展示附近的公共厕所"
    }
  },
  "requiredPrivateInfos": [
    "getLocation",
    "chooseLocation"
  ],
  "style": "v2",
  "__usePrivacyCheck__": false,
  "componentFramework": "glass-easel",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents",
  "usingComponents": {
    "van-skeleton": "/miniprogram_npm/@vant/weapp/skeleton/index",
    "van-loading": "/miniprogram_npm/@vant/weapp/loading/index",
    "van-empty": "/miniprogram_npm/@vant/weapp/empty/index"
  }
